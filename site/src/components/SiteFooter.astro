---
import { getCollection } from 'astro:content';
import BrandMark from './BrandMark.astro';
import UpdateSignup from './UpdateSignup.astro';

interface Props {
  /** Overrides the "corrections welcome" line for pages that live elsewhere in the repo. */
  blurb?: string;
  /** Off on pages that already carry the signup, so nobody is asked twice. */
  signup?: boolean;
}

const { blurb, signup = true } = Astro.props;

const features = (await getCollection('features')).sort((a, b) => a.data.order - b.data.order);

const REPO = 'https://github.com/dennisklappe/mattermore';

const docs = [
  { href: '/install', label: 'Install' },
  { href: '/selfhost', label: 'Self-host from scratch' },
  { href: '/configuration', label: 'Configuration' },
  { href: '/troubleshooting', label: 'Troubleshooting' },
  { href: '/licensing', label: 'Licensing' },
];

const project = [
  { href: REPO, label: 'Source code' },
  { href: `${REPO}/releases`, label: 'Releases' },
  { href: `${REPO}/issues`, label: 'Report a problem' },
  { href: 'https://github.com/users/dennisklappe/projects/2', label: 'What we are working on' },
  { href: 'https://www.gnu.org/licenses/agpl-3.0.html', label: 'AGPL v3.0' },
];
---
<footer class="site-foot">
  <div class="shell">
    <div class="foot-grid">
      <div class="foot-brand">
        <a class="brand" href="/"><BrandMark />Mattermore</a>
        <p>Mattermost, but more. A maintained fork that turns the paywalled parts back on, changing only AGPL code.</p>
        {signup && (
          <UpdateSignup
            source="footer"
            variant="compact"
            heading="Release mail"
            blurb="One mail when a release matters, especially an upstream security fix."
          />
        )}
      </div>

      <nav aria-label="Features">
        <p class="col-label">Features</p>
        <ul>
          {features.map((f) => <li><a href={`/${f.id}`}>{f.data.label}</a></li>)}
        </ul>
      </nav>

      <nav aria-label="Documentation">
        <p class="col-label">Docs</p>
        <ul>
          {docs.map((d) => <li><a href={d.href}>{d.label}</a></li>)}
        </ul>
      </nav>

      <nav aria-label="Project">
        <p class="col-label">Project</p>
        <ul>
          {project.map((p) => (
            <li><a href={p.href} target="_blank" rel="noopener noreferrer">{p.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="foot-base">
      <p>
        Not affiliated with, endorsed by, or supported by Mattermost, Inc.
        "Mattermost" is their trademark, used here only to describe what this
        software is compatible with.
      </p>
      {blurb ? <p set:html={blurb} /> : (
        <p>This site lives in the <a href={`${REPO}/tree/main/site`} target="_blank" rel="noopener noreferrer">repository</a>. Corrections are welcome as a pull request.</p>
      )}
    </div>
  </div>
</footer>
