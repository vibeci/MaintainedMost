---
import { getCollection } from 'astro:content';
import Base from './Base.astro';
import TopBar from '../components/TopBar.astro';
import SiteFooter from '../components/SiteFooter.astro';
import AiBar from '../components/AiBar.astro';

interface Props {
  title: string;
  description: string;
  slug: string;
  faq: { question: string; answer: string }[];
  headings: { depth: number; slug: string; text: string }[];
}

const { title, description, slug, faq, headings } = Astro.props;

const siblings = (await getCollection('features')).sort((a, b) => a.data.order - b.data.order);
const sections = headings.filter((h) => h.depth === 2);

// Structured data comes from the page's own FAQ section, so the two cannot
// drift apart.
const jsonLd =
  faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faq.map((entry) => ({
          '@type': 'Question',
          name: entry.question,
          acceptedAnswer: { '@type': 'Answer', text: entry.answer },
        })),
      }
    : undefined;
---
<Base title={`${title} | Mattermore`} description={description} ogType="article" jsonLd={jsonLd}>
  <TopBar />

  <main id="main">
    <section class="feature-hero">
      <div class="shell">
        <p class="crumb"><a href="/#compare">Features</a> <span>/</span> {title}</p>
        <h1>{title}</h1>
        <p class="sub">{description}</p>
        <div class="cta">
          <a class="btn btn-primary" href="/install">Install Mattermore</a>
          <a class="btn btn-ghost" href="/docs">Read the docs</a>
        </div>
      </div>
    </section>

    <div class="shell">
      <div class="feature-layout">
        <aside class="feature-aside">
          {sections.length >= 3 && (
            <nav class="feature-toc" aria-label="On this page">
              <p class="col-label">On this page</p>
              <ul>
                {sections.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
              </ul>
            </nav>
          )}
          <nav class="feature-sibs" aria-label="Other features">
            <p class="col-label">Also unlocked</p>
            <ul>
              {siblings.filter((p) => p.id !== slug).map((p) => (
                <li><a href={`/${p.id}`}>{p.data.label}</a></li>
              ))}
            </ul>
          </nav>
        </aside>

        <article class="feature-body">
          <AiBar slug={slug} />
          <slot />

          <aside class="feature-cta">
            <h2>Try it on your own server</h2>
            <p>Two steps on an existing Mattermost, or one image if you are starting fresh. Reversible either way.</p>
            <p>
              <a class="btn btn-primary" href="/install">Install guide</a>
              <a class="btn btn-ghost" href="/selfhost">Self-host from scratch</a>
            </p>
          </aside>
        </article>
      </div>
    </div>
  </main>

  <SiteFooter blurb={`This page lives in the <a href="https://github.com/dennisklappe/mattermore/edit/main/site/src/content/features/${slug}.md" target="_blank" rel="noopener noreferrer">repository</a> as markdown. Corrections are welcome as a pull request.`} />
</Base>
