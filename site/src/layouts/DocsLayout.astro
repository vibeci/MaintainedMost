---
import { getCollection } from 'astro:content';
import Base from './Base.astro';
import TopBar from '../components/TopBar.astro';
import SiteFooter from '../components/SiteFooter.astro';
import UpdateSignup from '../components/UpdateSignup.astro';

interface Props {
  title: string;
  description: string;
  slug: string;
  headings: { depth: number; slug: string; text: string }[];
}

const { title, description, slug, headings } = Astro.props;

const pages = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);

// An on-page contents list only helps once there are enough sections to scan.
const sections = headings.filter((h) => h.depth === 2);
const showToc = sections.length >= 3;

// Anyone reading these three is running a server, which is exactly who needs
// to hear about a security release. They get the ask in the page, not the
// footer.
const OPERATOR_PAGES = ['install', 'selfhost', 'upgrading'];
const inPageSignup = OPERATOR_PAGES.includes(slug);
---
<Base title={`${title} | Mattermore`} description={description} ogType="article">
  <TopBar current="docs" />

  <main class="shell" id="main">
    <div class="doc-layout">

      <nav class="doc-nav" aria-label="Documentation">
        <p class="col-label">Documentation</p>
        <ol>
          {pages.map((page) => (
            <li>
              <a
                href={`/${page.id}`}
                aria-current={page.id === slug ? 'page' : undefined}
              >{page.data.title}</a>
            </li>
          ))}
        </ol>
      </nav>

      <article class="doc-body">
        {slug !== 'docs' && (
          <p class="crumb"><a href="/docs">Docs</a> <span>/</span> {title}</p>
        )}
        <h1>{title}</h1>
        <p class="doc-lede">{description}</p>

        {showToc && (
          <nav class="doc-toc" aria-label="On this page">
            <p class="col-label">On this page</p>
            <ul>
              {sections.map((h) => (
                <li><a href={`#${h.slug}`}>{h.text}</a></li>
              ))}
            </ul>
          </nav>
        )}

        <slot />

        {inPageSignup && (
          <UpdateSignup
            source={`docs-${slug}`}
            variant="card"
            heading="Know when to upgrade"
            blurb="Mattermore follows upstream Mattermost. One mail when a release fixes something that matters, nothing else."
          />
        )}

        <p class="doc-edit">
          <a href={`https://github.com/dennisklappe/mattermore/edit/main/site/src/content/docs/${slug}.md`} target="_blank" rel="noopener noreferrer">
            Improve this page on GitHub
          </a>
        </p>
      </article>

    </div>
  </main>

  <SiteFooter signup={!inPageSignup} blurb='These docs live in the <a href="https://github.com/dennisklappe/mattermore/tree/main/site/src/content/docs" target="_blank" rel="noopener noreferrer">repository</a> as markdown. Corrections are welcome as a pull request.' />
</Base>
