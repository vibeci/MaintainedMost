# Single source of truth for what MaintainedMost builds from.
#
# Advance tags, commit pins and the matching runtime image together to pick up
# upstream security fixes. Each patch series is applied to a clean checkout.
# VibeCI can port conflicts as one verified transaction; see docs/maintenance.md.

# Mattermost server. Patches in patches/server/.
SERVER_TAG=v12.0.0
SERVER_COMMIT=1f5e0e9ba40da7ba0741659346e0a385a623d6a4
SERVER_IMAGE=docker.io/mattermost/mattermost-team-edition:12.0.0@sha256:c213d4eb01c2973a3814f57dab4e0629287b92896cb2f98d27134aa62ee5c3cc

# Calls plugin. Patches in patches/calls/.
CALLS_TAG=v1.12.5
CALLS_COMMIT=24414f57bca4332e53addc73dbbfa832e0b4d895
# Calls tracks the newest release compatible with the pinned server above.

# Must match props.calls_recorder_version in the pinned Calls manifest.
RECORDER_TAG=v0.8.13
RECORDER_SOURCE_IMAGE=docker.io/mattermost/calls-recorder:v0.8.13@sha256:8532abe26d24a6b8dbe0efc154b60aad3f72d77ab1b9128c6cd793b138e61ab2

# Unmodified offloader source used to test the real job-image validation contract.
OFFLOADER_TAG=v0.9.6
OFFLOADER_COMMIT=f239bd8c53b8281514cb354a988359b517d3df8c

# Call transcriber. Patches in patches/transcriber/.
TRANSCRIBER_TAG=c09a9a3c88ea29b2560002999f9b48e7d92f515f
TRANSCRIBER_BRANCH=master

# Toolchain used in CI and the transcriber's upstream native build.
GO_VERSION=1.26.7
NODE_VERSION=24

# MaintainedMost's own plugin version.
#
# This MUST stay above anything Mattermost ships prepackaged, or a server
# upgrade replaces MaintainedMost with official Calls. The server only overwrites
# an installed plugin when the prepackaged copy has a strictly higher version
# (server/channels/app/plugin.go, shouldPersistTransitionallyPrepackagedPlugin).
#
# Start at 1000.<upstream minor>.<upstream patch>, then also advance the bundle
# patch for MaintainedMost-only fixes so existing installations receive them.
# This is a bundle version, NOT an upgrade to the upstream CALLS_TAG above.
CALLS_VERSION=1000.12.5
