# Copy to .env and fill in.

# Existing Mattermore deployments MUST set this to their previous project name
# (usually mattermore) before `docker compose up` to reuse all named volumes.
# Use this override rather than `-p` so offloaded jobs join the same network.
COMPOSE_PROJECT_NAME=maintainedmost

# The address people will type. Must be the real one: calls and the recorder
# both use it to reach the server.
SITE_URL=https://chat.example.com

# Anything long and random.
POSTGRES_PASSWORD=

# A tested versioned release. Defaults to the vibeci-published images; override
# with your own registry build or maintainedmost:dev after running
# scripts/build-image.sh locally.
# Its matching patched transcriber image reference is baked into the server.
MAINTAINEDMOST_IMAGE=ghcr.io/vibeci/maintainedmost:latest

# Job namespace used when building that server image (normally its repository
# without the :tag). Set maintainedmost for the default local maintainedmost:dev build.
# Both calls-recorder and calls-transcriber images must exist under this prefix.
CALLS_IMAGE_REGISTRY=ghcr.io/vibeci/maintainedmost
