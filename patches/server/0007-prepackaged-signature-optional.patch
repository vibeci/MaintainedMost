+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+package app
+
+import (
+	"bytes"
+	"encoding/base64"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"sync/atomic"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"github.com/mattermost/mattermost/server/public/model"
+	"github.com/mattermost/mattermost/server/public/plugin"
+	"github.com/mattermost/mattermost/server/public/shared/httpservice"
+	"github.com/mattermost/mattermost/server/public/shared/mlog"
+	"github.com/mattermost/mattermost/server/v8/channels/app/platform"
+	storemocks "github.com/mattermost/mattermost/server/v8/channels/store/storetest/mocks"
+	"github.com/mattermost/mattermost/server/v8/channels/utils/fileutils"
+	"github.com/mattermost/mattermost/server/v8/config"
+	"github.com/mattermost/mattermost/server/v8/platform/shared/filestore"
+)
+
+// Exercise the real install, extraction, signature and persistence paths without
+// a database or plugin subprocess. The only signing key is upstream's test key.
+func maintainedmostPluginChannels(t *testing.T, requireSignature bool) (*Channels, string) {
+	t.Helper()
+	testsPath, found := fileutils.FindDir("tests")
+	require.True(t, found)
+	publicKey, err := os.ReadFile(filepath.Join(testsPath, "development-public-key.asc"))
+	require.NoError(t, err)
+	cs := config.NewTestMemoryStore()
+	t.Cleanup(func() { require.NoError(t, cs.Close()) })
+	cfg := cs.Get().Clone()
+	*cfg.PluginSettings.Enable = true
+	*cfg.PluginSettings.EnableRemoteMarketplace = false
+	*cfg.PluginSettings.AutomaticPrepackagedPlugins = false
+	*cfg.PluginSettings.RequirePluginSignature = requireSignature
+	*cfg.PluginSettings.Directory = t.TempDir()
+	*cfg.PluginSettings.ClientDirectory = t.TempDir()
+	*cfg.FileSettings.Directory = t.TempDir()
+	*cfg.ServiceSettings.AllowedUntrustedInternalConnections = "127.0.0.1"
+	cfg.PluginSettings.SignaturePublicKeyFiles = []string{"development-public-key.asc"}
+	require.NoError(t, cs.SetFile("development-public-key.asc", publicKey))
+	_, _, err = cs.Set(cfg)
+	require.NoError(t, err)
+
+	ps := &platform.PlatformService{Store: &storemocks.Store{}}
+	logger := mlog.CreateConsoleTestLogger(t)
+	ps.SetLogger(logger)
+	require.NoError(t, platform.ConfigStore(cs)(ps))
+	backend, err := filestore.NewFileBackend(filestore.FileBackendSettings{
+		DriverName: model.ImageDriverLocal,
+		Directory:  *cfg.FileSettings.Directory,
+	})
+	require.NoError(t, err)
+	require.NoError(t, platform.SetFileStore(backend)(ps))
+	env, err := plugin.NewEnvironment(nil, nil, *cfg.PluginSettings.Directory, *cfg.PluginSettings.ClientDirectory, logger, nil)
+	require.NoError(t, err)
+	t.Cleanup(env.Shutdown)
+	srv := &Server{platform: ps, httpService: httpservice.MakeHTTPService(ps)}
+	return &Channels{srv: srv, cfgSvc: ps, pluginsEnvironment: env}, testsPath
+}
+
+func maintainedmostPluginPath(t *testing.T, testsPath, signature string) *pluginSignaturePath {
+	t.Helper()
+	p := &pluginSignaturePath{pluginID: "testplugin", bundlePath: filepath.Join(testsPath, "testplugin.tar.gz")}
+	switch signature {
+	case "unsigned":
+	case "valid":
+		p.signaturePath = p.bundlePath + ".sig"
+	case "invalid":
+		p.signaturePath = filepath.Join(testsPath, "testplugin2.tar.gz.sig")
+	case "empty", "missing":
+		p.signaturePath = filepath.Join(t.TempDir(), "testplugin.tar.gz.sig")
+		if signature == "empty" {
+			require.NoError(t, os.WriteFile(p.signaturePath, nil, 0600))
+		}
+	default:
+		t.Fatalf("unknown signature fixture %q", signature)
+	}
+	return p
+}
+
+func TestMaintainedMostPrepackagedSignatures(t *testing.T) {
+	for _, required := range []bool{false, true} {
+		for _, signature := range []string{"unsigned", "valid", "invalid", "empty", "missing"} {
+			t.Run(fmt.Sprintf("required=%t/%s", required, signature), func(t *testing.T) {
+				ch, testsPath := maintainedmostPluginChannels(t, required)
+				path := maintainedmostPluginPath(t, testsPath, signature)
+				p, err := ch.processPrepackagedPlugin(path)
+				if signature != "unsigned" && signature != "valid" {
+					require.Error(t, err)
+					require.Nil(t, p)
+					if signature == "missing" {
+						require.ErrorIs(t, err, os.ErrNotExist)
+					} else {
+						require.Contains(t, err.Error(), "signature verification failed")
+					}
+					return
+				}
+				require.NoError(t, err)
+				require.Equal(t, "testplugin", p.Manifest.Id)
+				require.Equal(t, path.bundlePath, p.Path)
+				require.Equal(t, path.signaturePath, p.SignaturePath)
+				require.NotEmpty(t, p.IconData)
+				require.Equal(t, required, *ch.cfgSvc.Config().PluginSettings.RequirePluginSignature)
+			})
+		}
+	}
+}
+
+func TestMaintainedMostUnsignedPrepackagedStartup(t *testing.T) {
+	for _, tc := range []struct {
+		name      string
+		automatic bool
+		enabled   bool
+	}{
+		{"enabled", true, true},
+		{"not enabled", true, false},
+		{"automatic install disabled", false, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			ch, _ := maintainedmostPluginChannels(t, true)
+			const id = "com.maintainedmost.trusted"
+			ch.cfgSvc.UpdateConfig(func(cfg *model.Config) {
+				*cfg.PluginSettings.AutomaticPrepackagedPlugins = tc.automatic
+				cfg.PluginSettings.PluginStates[id] = &model.PluginState{Enable: tc.enabled}
+			})
+			bundle := makeInMemoryGzipTarFile(t, []testFile{
+				{"plugin.json", `{"id":"com.maintainedmost.trusted","version":"1.0.0","webapp":{"bundle_path":"main.js"}}`},
+				{"main.js", "// local image fixture"},
+			})
+			data, err := io.ReadAll(bundle)
+			require.NoError(t, err)
+			dir := t.TempDir()
+			require.NoError(t, os.WriteFile(filepath.Join(dir, id+".tar.gz"), data, 0600))
+			require.NoError(t, ch.processPrepackagedPlugins(dir))
+			require.Len(t, ch.pluginsEnvironment.PrepackagedPlugins(), 1)
+			available, err := ch.pluginsEnvironment.Available()
+			require.NoError(t, err)
+			if tc.automatic && tc.enabled {
+				require.Len(t, available, 1)
+				require.Equal(t, id, available[0].Manifest.Id)
+				require.True(t, ch.pluginsEnvironment.IsActive(id))
+				for range 2 {
+					manifest, appErr := ch.InstallMarketplacePlugin(&model.InstallMarketplacePluginRequest{Id: id, Version: "1.0.0"})
+					require.Nil(t, appErr)
+					require.Equal(t, id, manifest.Id)
+					require.True(t, ch.pluginsEnvironment.IsActive(id), "reinstall must reactivate the enabled plugin")
+				}
+			} else {
+				require.Empty(t, available)
+			}
+		})
+	}
+}
+
+func TestMaintainedMostMarketplacePrepackagedInstall(t *testing.T) {
+	for _, required := range []bool{false, true} {
+		for _, signature := range []string{"unsigned", "valid", "invalid", "empty", "missing"} {
+			t.Run(fmt.Sprintf("required=%t/%s", required, signature), func(t *testing.T) {
+				ch, testsPath := maintainedmostPluginChannels(t, required)
+				path := maintainedmostPluginPath(t, testsPath, signature)
+				p := &plugin.PrepackagedPlugin{
+					Manifest:      &model.Manifest{Id: "testplugin", Version: "0.0.1"},
+					Path:          path.bundlePath,
+					SignaturePath: path.signaturePath,
+				}
+				ch.pluginsEnvironment.SetPrepackagedPlugins([]*plugin.PrepackagedPlugin{p}, nil)
+				for range 2 { // Both installation and replacement must reach the real install path.
+					manifest, appErr := ch.InstallMarketplacePlugin(&model.InstallMarketplacePluginRequest{Id: p.Manifest.Id, Version: p.Manifest.Version})
+					if signature != "unsigned" && signature != "valid" {
+						require.NotNil(t, appErr)
+						require.Nil(t, manifest)
+						if signature == "missing" {
+							require.ErrorIs(t, appErr, os.ErrNotExist)
+						} else {
+							require.Equal(t, "api.plugin.verify_plugin.app_error", appErr.Id)
+						}
+						available, err := ch.pluginsEnvironment.Available()
+						require.NoError(t, err)
+						require.Empty(t, available)
+						require.NoFileExists(t, filepath.Join(*ch.cfgSvc.Config().FileSettings.Directory, getBundleStorePath(p.Manifest.Id)))
+						return
+					}
+					require.Nil(t, appErr)
+					require.Equal(t, p.Manifest.Id, manifest.Id)
+					require.Equal(t, p.Manifest.Version, manifest.Version)
+					installed, err := ch.pluginsEnvironment.GetManifest(manifest.Id)
+					require.NoError(t, err)
+					require.Equal(t, manifest.Version, installed.Version)
+					bundleBytes, err := os.ReadFile(p.Path)
+					require.NoError(t, err)
+					stored, err := ch.srv.FileBackend().ReadFile(getBundleStorePath(manifest.Id))
+					require.NoError(t, err)
+					require.Equal(t, bundleBytes, stored)
+					if signature == "valid" {
+						signatureBytes, err := os.ReadFile(p.SignaturePath)
+						require.NoError(t, err)
+						storedSignature, err := ch.srv.FileBackend().ReadFile(getSignatureStorePath(manifest.Id))
+						require.NoError(t, err)
+						require.Equal(t, signatureBytes, storedSignature)
+					} else {
+						require.NoFileExists(t, filepath.Join(*ch.cfgSvc.Config().FileSettings.Directory, getSignatureStorePath(manifest.Id)))
+					}
+				}
+				for _, request := range []*model.InstallMarketplacePluginRequest{
+					{Id: "other-plugin", Version: "0.0.1"},
+					{Id: p.Manifest.Id, Version: "0.0.2"},
+				} {
+					manifest, appErr := ch.InstallMarketplacePlugin(request)
+					require.Nil(t, manifest)
+					require.NotNil(t, appErr)
+					require.Equal(t, "app.plugin.marketplace_plugins.not_found.app_error", appErr.Id)
+				}
+				require.Equal(t, required, *ch.cfgSvc.Config().PluginSettings.RequirePluginSignature)
+			})
+		}
+	}
+}
+
+func TestMaintainedMostMarketplaceRemoteSignatures(t *testing.T) {
+	for _, required := range []bool{false, true} {
+		for _, source := range []string{"remote only", "upgrade from unsigned local", "requested version not local", "same version prefers local"} {
+			for _, signature := range []string{"unsigned", "valid", "invalid", "bad base64"} {
+				t.Run(fmt.Sprintf("required=%t/%s/%s", required, source, signature), func(t *testing.T) {
+					ch, testsPath := maintainedmostPluginChannels(t, required)
+					bundleBytes, err := os.ReadFile(filepath.Join(testsPath, "testplugin-v0.0.2.tar.gz"))
+					require.NoError(t, err)
+					var encodedSignature string
+					if signature == "valid" || signature == "invalid" {
+						filename := "testplugin-v0.0.2.tar.gz.sig"
+						if signature == "invalid" {
+							filename = "testplugin2.tar.gz.sig"
+						}
+						data, err := os.ReadFile(filepath.Join(testsPath, filename))
+						require.NoError(t, err)
+						encodedSignature = base64.StdEncoding.EncodeToString(data)
+					} else if signature == "bad base64" {
+						encodedSignature = "!not-base64"
+					}
+					var downloads atomic.Int32
+					marketplace := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+						switch r.URL.Path {
+						case "/api/v1/plugins":
+							assert.Equal(t, "testplugin", r.URL.Query().Get("plugin_id"))
+							assert.NoError(t, json.NewEncoder(w).Encode([]*model.BaseMarketplacePlugin{{
+								Manifest:    &model.Manifest{Id: "testplugin", Version: "0.0.2"},
+								DownloadURL: "http://" + r.Host + "/bundle",
+								Signature:   encodedSignature,
+							}}))
+						case "/bundle":
+							downloads.Add(1)
+							_, err := w.Write(bundleBytes)
+							assert.NoError(t, err)
+						default:
+							t.Errorf("unexpected marketplace request: %s", r.URL.Path)
+							w.WriteHeader(http.StatusNotFound)
+						}
+					}))
+					defer marketplace.Close()
+					ch.cfgSvc.UpdateConfig(func(cfg *model.Config) {
+						*cfg.PluginSettings.EnableRemoteMarketplace = true
+						*cfg.PluginSettings.MarketplaceURL = marketplace.URL
+						*cfg.PluginSettings.AllowInsecureDownloadURL = true // Loopback httptest server only.
+					})
+					if source != "remote only" {
+						path := maintainedmostPluginPath(t, testsPath, "unsigned")
+						if source == "same version prefers local" {
+							path.bundlePath = filepath.Join(testsPath, "testplugin-v0.0.2.tar.gz")
+						}
+						p, err := ch.processPrepackagedPlugin(path)
+						require.NoError(t, err)
+						ch.pluginsEnvironment.SetPrepackagedPlugins([]*plugin.PrepackagedPlugin{p}, nil)
+					}
+					request := &model.InstallMarketplacePluginRequest{Id: "testplugin"}
+					if source == "requested version not local" {
+						request.Version = "0.0.2"
+					}
+					manifest, appErr := ch.InstallMarketplacePlugin(request)
+					local := source == "same version prefers local"
+					if local {
+						require.Zero(t, downloads.Load())
+					} else {
+						require.EqualValues(t, 1, downloads.Load())
+					}
+					if signature == "valid" || local {
+						require.Nil(t, appErr)
+						require.Equal(t, "0.0.2", manifest.Version)
+						installed, err := ch.pluginsEnvironment.GetManifest(manifest.Id)
+						require.NoError(t, err)
+						require.Equal(t, manifest.Version, installed.Version)
+						stored, err := ch.srv.FileBackend().ReadFile(getBundleStorePath(manifest.Id))
+						require.NoError(t, err)
+						require.Equal(t, bundleBytes, stored)
+					} else {
+						require.Nil(t, manifest)
+						require.NotNil(t, appErr)
+						if signature == "bad base64" {
+							require.Equal(t, "app.plugin.signature_decode.app_error", appErr.Id)
+						} else {
+							require.Equal(t, "api.plugin.verify_plugin.app_error", appErr.Id)
+						}
+						available, err := ch.pluginsEnvironment.Available()
+						require.NoError(t, err)
+						require.Empty(t, available)
+						require.NoFileExists(t, filepath.Join(*ch.cfgSvc.Config().FileSettings.Directory, getBundleStorePath(request.Id)))
+					}
+					require.Equal(t, required, *ch.cfgSvc.Config().PluginSettings.RequirePluginSignature)
+				})
+			}
+		}
+	}
+}
