+func TestMaintainedMostTransitionalPrepackagedPersistence(t *testing.T) {
+	for _, required := range []bool{false, true} {
+		for _, signature := range []string{"unsigned", "valid", "invalid", "empty", "missing"} {
+			t.Run(fmt.Sprintf("required=%t/%s", required, signature), func(t *testing.T) {
+				ch, testsPath := maintainedmostPluginChannels(t, required)
+				path := maintainedmostPluginPath(t, testsPath, signature)
+				p := &plugin.PrepackagedPlugin{
+					Manifest:      &model.Manifest{Id: "testplugin", Version: "0.0.1"},
+					Path:          path.bundlePath,
+					SignaturePath: path.signaturePath,
+				}
+				ch.pluginsEnvironment.SetPrepackagedPlugins(nil, []*plugin.PrepackagedPlugin{p})
+				ch.persistTransitionallyPrepackagedPlugins()
+				require.Empty(t, ch.pluginsEnvironment.TransitionallyPrepackagedPlugins())
+				if signature != "unsigned" && signature != "valid" {
+					require.NoFileExists(t, filepath.Join(*ch.cfgSvc.Config().FileSettings.Directory, getBundleStorePath(p.Manifest.Id)))
+					require.NoFileExists(t, filepath.Join(*ch.cfgSvc.Config().FileSettings.Directory, getSignatureStorePath(p.Manifest.Id)))
+					return
+				}
+				expectedBundle, err := os.ReadFile(p.Path)
+				require.NoError(t, err)
+				stored, err := ch.srv.FileBackend().ReadFile(getBundleStorePath(p.Manifest.Id))
+				require.NoError(t, err)
+				require.Equal(t, expectedBundle, stored)
+				if signature == "valid" {
+					expectedSignature, err := os.ReadFile(p.SignaturePath)
+					require.NoError(t, err)
+					storedSignature, err := ch.srv.FileBackend().ReadFile(getSignatureStorePath(p.Manifest.Id))
+					require.NoError(t, err)
+					require.Equal(t, expectedSignature, storedSignature)
+					require.Nil(t, ch.verifyPlugin(ch.srv.Log(), bytes.NewReader(stored), bytes.NewReader(storedSignature)))
+				} else {
+					require.NoFileExists(t, filepath.Join(*ch.cfgSvc.Config().FileSettings.Directory, getSignatureStorePath(p.Manifest.Id)))
+				}
+			})
+		}
+	}
+}
+
+func TestMaintainedMostFilestoreSignatureEnforcement(t *testing.T) {
+	for _, source := range []string{"sync", "cluster"} {
+		for _, signature := range []string{"unsigned", "valid", "invalid", "empty"} {
+			t.Run(source+"/"+signature, func(t *testing.T) {
+				ch, testsPath := maintainedmostPluginChannels(t, true)
+				path := maintainedmostPluginPath(t, testsPath, signature)
+				data, err := os.ReadFile(path.bundlePath)
+				require.NoError(t, err)
+				_, err = ch.srv.FileBackend().WriteFile(bytes.NewReader(data), getBundleStorePath(path.pluginID))
+				require.NoError(t, err)
+				if signature != "unsigned" {
+					data, err = os.ReadFile(path.signaturePath)
+					require.NoError(t, err)
+					_, err = ch.srv.FileBackend().WriteFile(bytes.NewReader(data), getSignatureStorePath(path.pluginID))
+					require.NoError(t, err)
+				}
+				// Even a known, trusted local bundle must not exempt a filestore copy.
+				p, err := ch.processPrepackagedPlugin(maintainedmostPluginPath(t, testsPath, "unsigned"))
+				require.NoError(t, err)
+				ch.pluginsEnvironment.SetPrepackagedPlugins([]*plugin.PrepackagedPlugin{p}, nil)
+				if source == "sync" {
+					require.Nil(t, ch.syncPlugins())
+				} else {
+					ch.installPluginFromClusterMessage(path.pluginID)
+				}
+				available, err := ch.pluginsEnvironment.Available()
+				require.NoError(t, err)
+				if signature == "valid" {
+					require.Len(t, available, 1)
+					require.Equal(t, path.pluginID, available[0].Manifest.Id)
+				} else {
+					require.Empty(t, available)
+				}
+				require.True(t, *ch.cfgSvc.Config().PluginSettings.RequirePluginSignature)
+			})
+		}
+	}
+}
