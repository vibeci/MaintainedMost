+)
+
+func TestMaintainedMostPluginInstallGuards(t *testing.T) {
+	st := testlib.GetMockStoreForSetupFunctions()
+	th := setupTestHelper(t, st, nil, nil, false, false, func(cfg *model.Config) {
+		*cfg.CacheSettings.CacheType = model.CacheTypeLRU
+		*cfg.PluginSettings.Enable = true
+		*cfg.PluginSettings.EnableUploads = true
+		*cfg.PluginSettings.EnableMarketplace = true
+		*cfg.PluginSettings.EnableRemoteMarketplace = false
+		*cfg.PluginSettings.RequirePluginSignature = true
+	}, nil)
+	th.App.GetPluginsEnvironment().SetPrepackagedPlugins([]*plugin.PrepackagedPlugin{{
+		Manifest: &model.Manifest{Id: "testplugin", Version: "0.0.1"},
+	}}, nil)
+
+	for _, tc := range []struct {
+		name    string
+		handler func(*Context, http.ResponseWriter, *http.Request)
+		errorID string
+	}{
+		{"upload", uploadPlugin, "app.plugin.upload_disabled.app_error"},
+		{"URL", installPluginFromURL, "app.plugin.disabled.app_error"},
+	} {
+		t.Run("signature required/"+tc.name, func(t *testing.T) {
+			c := &Context{App: th.App, AppContext: request.TestContext(t).WithSession(&model.Session{Roles: model.SystemAdminRoleId}), Logger: th.TestLogger}
+			tc.handler(c, httptest.NewRecorder(), httptest.NewRequest(http.MethodPost, "/api/v4/plugins", nil))
+			require.NotNil(t, c.Err)
+			require.Equal(t, tc.errorID, c.Err.Id)
+			require.Equal(t, http.StatusNotImplemented, c.Err.StatusCode)
+		})
+	}
+
+	roles := st.Role().(*mocks.RoleStore)
+	roles.On("GetByNames", []string{model.SystemUserRoleId}).Return([]*model.Role{{Name: model.SystemUserRoleId}}, nil)
+	for _, required := range []bool{true, false} {
+		th.App.UpdateConfig(func(cfg *model.Config) { *cfg.PluginSettings.RequirePluginSignature = required })
+		for _, tc := range []struct {
+			name    string
+			handler func(*Context, http.ResponseWriter, *http.Request)
+		}{
+			{"upload", uploadPlugin},
+			{"URL", installPluginFromURL},
+			{"marketplace", installMarketplacePlugin},
+		} {
+			if required && tc.name != "marketplace" {
+				continue // These are rejected by the signature policy before authorization.
+			}
+			t.Run(fmt.Sprintf("permission required/signatures=%t/%s", required, tc.name), func(t *testing.T) {
+				c := &Context{App: th.App, AppContext: request.TestContext(t).WithSession(&model.Session{UserId: model.NewId(), Roles: model.SystemUserRoleId}), Logger: th.TestLogger}
+				tc.handler(c, httptest.NewRecorder(), httptest.NewRequest(http.MethodPost, "/api/v4/plugins", strings.NewReader(`{"id":"testplugin"}`)))
+				require.NotNil(t, c.Err)
+				require.Equal(t, "api.context.permissions.app_error", c.Err.Id)
+				require.Equal(t, http.StatusForbidden, c.Err.StatusCode)
+			})
+		}
+	}
+	roles.AssertExpectations(t)
+}
