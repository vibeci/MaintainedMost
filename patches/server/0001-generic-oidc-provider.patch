+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+package oauthopenid
+
+import (
+	"encoding/base64"
+	"encoding/json"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"github.com/mattermost/mattermost/server/public/shared/request"
+)
+
+// Claim tests use a structurally signed token: the production authentication
+// source is the TLS-protected code exchange, not this dummy JWS signature.
+func makeIDToken(payload string) string {
+	enc := base64.RawURLEncoding.EncodeToString
+	return enc([]byte(`{"alg":"RS256","typ":"JWT"}`)) + "." + enc([]byte(payload)) + "." + enc([]byte("fixture-signature"))
+}
+
+func TestParseIDToken(t *testing.T) {
+	now := time.Unix(1_700_000_000, 0)
+	const issuer = "https://idp.example.com/realms/mattermost"
+	const clientID = "client-id"
+	for _, tc := range []struct {
+		name  string
+		edit  func(map[string]any)
+		valid bool
+	}{
+		{"valid", func(map[string]any) {}, true},
+		{"missing issuer", func(c map[string]any) { delete(c, "iss") }, false},
+		{"wrong issuer host", func(c map[string]any) { c["iss"] = "https://other.example.com/realms/mattermost" }, false},
+		{"wrong issuer path", func(c map[string]any) { c["iss"] = "https://idp.example.com/realms/other" }, false},
+		{"different issuer spelling", func(c map[string]any) { c["iss"] = issuer + "/" }, false},
+		{"missing audience", func(c map[string]any) { delete(c, "aud") }, false},
+		{"empty audience", func(c map[string]any) { c["aud"] = "" }, false},
+		{"null audience", func(c map[string]any) { c["aud"] = nil }, false},
+		{"empty audience array", func(c map[string]any) { c["aud"] = []string{} }, false},
+		{"wrong audience", func(c map[string]any) { c["aud"] = "other-client" }, false},
+		{"non-string audience", func(c map[string]any) { c["aud"] = 123 }, false},
+		{"single audience array", func(c map[string]any) { c["aud"] = []string{clientID} }, true},
+		{"multi audience without azp", func(c map[string]any) { c["aud"] = []string{clientID, "other-client"} }, false},
+		{"multi audience with wrong azp", func(c map[string]any) { c["aud"] = []string{clientID, "other-client"}; c["azp"] = "other-client" }, false},
+		{"multi audience with correct azp", func(c map[string]any) { c["aud"] = []string{clientID, "other-client"}; c["azp"] = clientID }, true},
+		{"single audience with wrong azp", func(c map[string]any) { c["azp"] = "other-client" }, false},
+		{"empty azp", func(c map[string]any) { c["azp"] = "" }, false},
+		{"malformed azp", func(c map[string]any) { c["azp"] = true }, false},
+		{"missing sub", func(c map[string]any) { delete(c, "sub") }, false},
+		{"empty sub", func(c map[string]any) { c["sub"] = "" }, false},
+		{"numeric sub", func(c map[string]any) { c["sub"] = 123 }, false},
+		{"non-ASCII sub", func(c map[string]any) { c["sub"] = "\u00e9" }, false},
+		{"long sub", func(c map[string]any) { c["sub"] = strings.Repeat("a", 256) }, false},
+		{"missing exp", func(c map[string]any) { delete(c, "exp") }, false},
+		{"null exp", func(c map[string]any) { c["exp"] = nil }, false},
+		{"malformed exp", func(c map[string]any) { c["exp"] = "tomorrow" }, false},
+		{"expired", func(c map[string]any) { c["exp"] = now.Add(-time.Hour).Unix() }, false},
+		{"expiry within skew", func(c map[string]any) { c["exp"] = now.Add(-time.Minute).Unix() }, true},
+		{"missing iat", func(c map[string]any) { delete(c, "iat") }, false},
+		{"null iat", func(c map[string]any) { c["iat"] = nil }, false},
+		{"malformed iat", func(c map[string]any) { c["iat"] = true }, false},
+		{"future iat", func(c map[string]any) { c["iat"] = now.Add(time.Hour).Unix() }, false},
+		{"iat within skew", func(c map[string]any) { c["iat"] = now.Add(time.Minute).Unix() }, true},
+		{"exp not after iat", func(c map[string]any) { c["exp"] = now.Add(-time.Minute).Unix(); c["iat"] = c["exp"] }, false},
+		{"future nbf", func(c map[string]any) { c["nbf"] = now.Add(time.Hour).Unix() }, false},
+		{"nbf within skew", func(c map[string]any) { c["nbf"] = now.Add(time.Minute).Unix() }, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			claims := map[string]any{"iss": issuer, "aud": clientID, "sub": "abc", "exp": now.Add(2 * time.Hour).Unix(), "iat": now.Add(-2 * time.Hour).Unix(), "name": "Jane Doe"}
+			tc.edit(claims)
+			payload, err := json.Marshal(claims)
+			require.NoError(t, err)
+			parsed, err := parseIDToken(makeIDToken(string(payload)), issuer, clientID, now)
+			if tc.valid {
+				require.NoError(t, err)
+				assert.Equal(t, "abc", parsed.Subject)
+				assert.Equal(t, "Jane Doe", parsed.Name)
+			} else {
+				require.Error(t, err)
+			}
+		})
+	}
+	for _, token := range []string{"", "abcdef", "aaa.bbb", ".bbb.ccc", "aaa.!!!.ccc", "aaa." + base64.RawURLEncoding.EncodeToString([]byte("nope")) + ".ccc", strings.Repeat("a", maxIDTokenSize+1)} {
+		_, err := parseIDToken(token, issuer, clientID, now)
+		require.Error(t, err)
+	}
+	payload := `{"iss":"https://idp.example.com/realms/mattermost","aud":"client-id","sub":"abc","iat":1699999900,"exp":1700003600}`
+	valid := makeIDToken(payload)
+	for _, token := range []string{
+		base64.RawURLEncoding.EncodeToString([]byte(`{"alg":"none"}`)) + "." + strings.Split(valid, ".")[1] + ".",
+		valid[:strings.LastIndex(valid, ".")+1],
+		valid[:strings.LastIndex(valid, ".")+1] + "!!!",
+		valid + "\n",
+	} {
+		_, err := parseIDToken(token, issuer, clientID, now)
+		require.Error(t, err)
+	}
+	_, err := parseIDToken(valid, "", clientID, now)
+	require.Error(t, err)
+	_, err = parseIDToken(valid, issuer, "", now)
+	require.Error(t, err)
+}
+
+func TestGetUserFromIdTokenRequiresExchange(t *testing.T) {
+	for _, token := range []string{"", makeIDToken(`{"sub":"abc"}`)} {
+		user, err := New().GetUserFromIdToken(request.TestContext(t), token)
+		require.ErrorContains(t, err, "authorization-code exchange")
+		require.Nil(t, user)
+	}
+}
diff --git a/server/channels/app/oauthproviders/openid/openid.go b/server/channels/app/oauthproviders/openid/openid.go
new file mode 100644
index 00000000..f926888b
--- /dev/null
+++ b/server/channels/app/oauthproviders/openid/openid.go
@@ -0,0 +1,310 @@
+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+// Package oauthopenid implements einterfaces.OAuthProvider for any standard
+// OpenID Connect identity provider.
+//
+// It is registered under the "openid" service name. App.getSSOProvider routes
+// every SSO service whose configured scope contains "openid" to this provider,
+// so a GitLab, Google or Office 365 configuration using the OpenID Connect
+// scope is handled here as well, while the same configuration without that
+// scope keeps using its dedicated provider. GetSSOSettings therefore accepts
+// every service name Config.GetSSOService knows.
+package oauthopenid
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"slices"
+	"strings"
+
+	"github.com/mattermost/mattermost/server/public/model"
+	"github.com/mattermost/mattermost/server/public/shared/httpservice"
+	"github.com/mattermost/mattermost/server/public/shared/mlog"
+	"github.com/mattermost/mattermost/server/public/shared/request"
+)
+
+// maxUserInfoSize bounds the userinfo document we are willing to decode. The
+// body is produced by the identity provider, but a misbehaving or compromised
+// one should not be able to make us allocate without limit.
+const maxUserInfoSize = 1 << 20 // 1MB
+
+// A provider is shared, but each discovery request owns its configuration.
+type requestConfig struct {
+	config *model.Config
+}
+
+func (c *requestConfig) Config() *model.Config {
+	return c.config
+}
+
+// OpenIDProvider implements einterfaces.OAuthProvider for generic OpenID
+// Connect identity providers.
+type OpenIDProvider struct {
+	discovery   *discoveryCache
+	httpService httpservice.HTTPService
+}
+
+// New returns a provider with its own discovery document cache, making its
+// outbound requests through httpservice over the configuration of the request
+// being served.
+func New() *OpenIDProvider {
+	return &OpenIDProvider{discovery: newDiscoveryCache()}
+}
+
+// NewWithHTTPService injects the discovery HTTP service, for example to trust a
+// test CA. Code exchange always uses the requesting app's HTTP service.
+func NewWithHTTPService(httpService httpservice.HTTPService) *OpenIDProvider {
+	p := New()
+	p.httpService = httpService
+	return p
+}
+
+// OpenIDUser holds the standard OpenID Connect claims Mattermost cares about.
+type OpenIDUser struct {
+	Subject           string `json:"sub"`
+	Email             string `json:"email"`
+	EmailVerified     *bool  `json:"email_verified"`
+	PreferredUsername string `json:"preferred_username"`
+	Name              string `json:"name"`
+	GivenName         string `json:"given_name"`
+	FamilyName        string `json:"family_name"`
+	Nickname          string `json:"nickname"`
+}
+
+func validateSubject(subject string) error {
+	if strings.TrimSpace(subject) == "" || len(subject) > 255 || strings.ContainsFunc(subject, func(r rune) bool { return r > 127 }) {
+		return errors.New("the sub claim must be a nonempty ASCII string of at most 255 characters")
+	}
+	return nil
+}
+
+func (u *OpenIDUser) IsValid() error {
+	if err := validateSubject(u.Subject); err != nil {
+		return err
+	}
+
+	if u.Email == "" {
+		return errors.New("the email claim is missing from the OpenID Connect response")
+	}
+	if len(u.Email) > model.UserEmailMaxLength || !model.IsValidEmail(strings.ToLower(u.Email)) {
+		return errors.New("the email claim is not a valid email address")
+	}
+
+	// CreateOAuthUser marks SSO accounts verified. Never let an absent, null,
+	// false, or non-boolean assertion acquire that trust implicitly.
+	if u.EmailVerified == nil || !*u.EmailVerified {
+		return errors.New("the userinfo response must assert email_verified: true")
+	}
+
+	return nil
+}
+
+func openIDUserFromJSON(data io.Reader) (*OpenIDUser, error) {
+	body, err := readBounded(data, maxUserInfoSize)
+	if err != nil {
+		return nil, err
+	}
+	var oiu OpenIDUser
+	if err := json.Unmarshal(body, &oiu); err != nil {
+		return nil, err
+	}
+	return &oiu, nil
+}
+
+// usernameFrom derives a valid Mattermost username from the available claims.
+// model.CleanUsername lowercases the result, replaces the characters that are
+// not allowed and generates a random username as a last resort, so this never
+// fails the login.
+func usernameFrom(logger mlog.LoggerIFace, oiu *OpenIDUser, settings *model.SSOSettings) string {
+	var username string
+
+	switch {
+	case settings != nil && model.SafeDereference(settings.UsePreferredUsername) && oiu.PreferredUsername != "":
+		// Consistent with the other providers: a preferred username that looks
+		// like an address is reduced to its local part.
+		username = strings.Split(oiu.PreferredUsername, "@")[0]
+	case oiu.Email != "":
+		username = strings.Split(oiu.Email, "@")[0]
+	case oiu.PreferredUsername != "":
+		username = strings.Split(oiu.PreferredUsername, "@")[0]
+	case oiu.Nickname != "":
+		username = oiu.Nickname
+	case oiu.Name != "":
+		username = oiu.Name
+	default:
+		username = oiu.Subject
+	}
+
+	return model.CleanUsername(logger, username)
+}
+
+// namesFrom returns the first and last name, preferring the discrete claims
+// and falling back to splitting the display name.
+func namesFrom(oiu *OpenIDUser) (firstName, lastName string) {
+	if oiu.GivenName != "" || oiu.FamilyName != "" {
+		return oiu.GivenName, oiu.FamilyName
+	}
+
+	splitName := strings.Fields(oiu.Name)
+	switch len(splitName) {
+	case 0:
+		return "", ""
+	case 1:
+		return splitName[0], ""
+	default:
+		return splitName[0], strings.Join(splitName[1:], " ")
+	}
+}
+
+func userFromOpenIDUser(logger mlog.LoggerIFace, oiu *OpenIDUser, settings *model.SSOSettings) *model.User {
+	user := &model.User{}
+
+	user.Username = usernameFrom(logger, oiu, settings)
+	user.FirstName, user.LastName = namesFrom(oiu)
+	user.Nickname = oiu.Nickname
+	user.Email = strings.ToLower(oiu.Email)
+
+	authData := oiu.Subject
+	user.AuthData = &authData
+
+	// AuthService is deliberately left empty. This provider serves several
+	// service names and the caller fills in the service it was invoked with,
+	// which IsSameUser then relies on.
+
+	return user
+}
+
+// GetUserFromJSON parses a standard OpenID Connect userinfo response.
+//
+// Exchange authenticates the ID token using the token endpoint's TLS identity
+// and validates its claims. UserInfo must name exactly the same subject and
+// independently assert a verified email; only cosmetic fields may come from
+// the ID token.
+func (p *OpenIDProvider) GetUserFromJSON(rctx request.CTX, data io.Reader, tokenUser *model.User, settings *model.SSOSettings) (*model.User, error) {
+	if tokenUser == nil || tokenUser.AuthData == nil || *tokenUser.AuthData == "" {
+		return nil, errors.New("a validated ID token is required before accepting userinfo")
+	}
+
+	oiu, err := openIDUserFromJSON(data)
+	if err != nil {
+		return nil, err
+	}
+
+	if *tokenUser.AuthData != oiu.Subject {
+		return nil, errors.New("the subject of the ID token does not match the subject of the userinfo response")
+	}
+
+	if err = oiu.IsValid(); err != nil {
+		return nil, err
+	}
+
+	user := userFromOpenIDUser(rctx.Logger(), oiu, settings)
+
+	if user.FirstName == "" && user.LastName == "" {
+		user.FirstName = tokenUser.FirstName
+		user.LastName = tokenUser.LastName
+	}
+	if user.Nickname == "" {
+		user.Nickname = tokenUser.Nickname
+	}
+
+	return user, nil
+}
+
+// GetSSOSettings returns a copy with authoritative, validated discovery
+// endpoints, including when legacy Google/Microsoft defaults are populated.
+func (p *OpenIDProvider) GetSSOSettings(rctx request.CTX, config *model.Config, service string) (*model.SSOSettings, error) {
+	httpService := p.httpService
+	if httpService == nil {
+		httpService = httpservice.MakeHTTPService(&requestConfig{config: config})
+	}
+	client, err := newHTTPClient(httpService)
+	if err != nil {
+		return nil, err
+	}
+	defer client.CloseIdleConnections()
+	settings, _, err := p.resolveSettings(rctx, config, service, client)
+	return settings, err
+}
+
+func (p *OpenIDProvider) resolveSettings(rctx request.CTX, config *model.Config, service string, client *http.Client) (*model.SSOSettings, *discoveryDocument, error) {
+	configured := config.GetSSOService(service)
+	if configured == nil {
+		return nil, nil, fmt.Errorf("the %q service is not handled by the OpenID Connect provider", service)
+	}
+
+	if !model.SafeDereference(configured.Enable) {
+		return nil, nil, fmt.Errorf("the %q service is not enabled", service)
+	}
+
+	settings := *configured
+	if err := validateSettings(&settings, service); err != nil {
+		return nil, nil, err
+	}
+
+	doc, err := p.discovery.get(rctx, *settings.DiscoveryEndpoint, model.SafeDereference(config.ServiceSettings.AllowedUntrustedInternalConnections), client)
+	if err != nil {
+		return nil, nil, fmt.Errorf("unable to resolve OpenID Connect discovery for the %q service: %w", service, err)
+	}
+	settings.AuthEndpoint = model.NewPointer(doc.AuthorizationEndpoint)
+	settings.TokenEndpoint = model.NewPointer(doc.TokenEndpoint)
+	settings.UserAPIEndpoint = model.NewPointer(doc.UserInfoEndpoint)
+	return &settings, doc, nil
+}
+
+func validateSettings(settings *model.SSOSettings, service string) error {
+	missing := []string{}
+	if model.SafeDereference(settings.Id) == "" {
+		missing = append(missing, "Id")
+	}
+	if model.SafeDereference(settings.Secret) == "" {
+		missing = append(missing, "Secret")
+	}
+	if len(missing) > 0 {
+		return fmt.Errorf("the %q service is missing required settings: %s", service, strings.Join(missing, ", "))
+	}
+
+	if strings.TrimSpace(model.SafeDereference(settings.DiscoveryEndpoint)) == "" {
+		return fmt.Errorf("the %q service requires DiscoveryEndpoint with the expected issuer URL; endpoint-only configuration cannot securely bind the issuer", service)
+	}
+	if !slices.Contains(strings.Fields(model.SafeDereference(settings.Scope)), "openid") {
+		return fmt.Errorf("the %q service requires the openid scope", service)
+	}
+
+	return nil
+}
+
+// IsSameUser reports whether both users are the same account of the same
+// identity provider.
+//
+// The service has to match as well as the subject. App.CreateOAuthUser calls
+// this to decide whether an existing account found by email address may be
+// converted to the incoming SSO identity, and an LDAP or SAML account whose
+// AuthData happens to equal an OpenID Connect subject must not be.
+func (p *OpenIDProvider) IsSameUser(_ request.CTX, dbUser, oAuthUser *model.User) bool {
+	if dbUser == nil || oAuthUser == nil || dbUser.AuthData == nil || oAuthUser.AuthData == nil {
+		return false
+	}
+
+	if *dbUser.AuthData == "" || *oAuthUser.AuthData == "" {
+		return false
+	}
+
+	// The caller fills in AuthService with the service it was invoked with, see
+	// userFromOpenIDUser.
+	if dbUser.AuthService == "" || dbUser.AuthService != oAuthUser.AuthService {
+		return false
+	}
+
+	return *dbUser.AuthData == *oAuthUser.AuthData
+}
+
+// The legacy interface has neither issuer nor client context. Only Exchange may
+// validate an ID token, using the settings resolved for that exact request.
+func (p *OpenIDProvider) GetUserFromIdToken(_ request.CTX, _ string) (*model.User, error) {
+	return nil, errors.New("OpenID Connect ID tokens must be validated by the authorization-code exchange")
+}
diff --git a/server/channels/app/oauthproviders/openid/openid_test.go b/server/channels/app/oauthproviders/openid/openid_test.go
new file mode 100644
index 00000000..62b678c0
--- /dev/null
+++ b/server/channels/app/oauthproviders/openid/openid_test.go
@@ -0,0 +1,223 @@
+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+package oauthopenid
+
+import (
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync/atomic"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"github.com/mattermost/mattermost/server/public/model"
+	"github.com/mattermost/mattermost/server/public/shared/request"
+	"github.com/mattermost/mattermost/server/v8/einterfaces"
+)
+
+func TestRegistered(t *testing.T) {
+	require.NotNil(t, einterfaces.GetOAuthProvider(model.ServiceOpenid))
+	require.Implements(t, (*einterfaces.OAuthCodeExchanger)(nil), New())
+}
+
+func TestGetUserFromJSON(t *testing.T) {
+	rctx := request.TestContext(t)
+	p := New()
+	tokenUser := &model.User{AuthData: model.NewPointer("abc"), Email: "never-use-token-email@example.com", FirstName: "Token", LastName: "Name", Nickname: "token-nick"}
+	for _, tc := range []struct {
+		name, body, username, first, last, nickname string
+		preferred                                   bool
+	}{
+		{"standard claims", `{"sub":"abc","email":"Jane.Doe@Example.COM","email_verified":true,"preferred_username":"jdoe","given_name":"Jane","family_name":"Doe","nickname":"janey"}`, "jane.doe", "Jane", "Doe", "janey", false},
+		{"preferred username", `{"sub":"abc","email":"jane.doe@example.com","email_verified":true,"preferred_username":"jdoe@example.com"}`, "jdoe", "Token", "Name", "token-nick", true},
+		{"split display name", `{"sub":"abc","email":"a@b.com","email_verified":true,"name":"Jan van der Berg"}`, "a", "Jan", "van der Berg", "token-nick", false},
+		{"single word name", `{"sub":"abc","email":"a@b.com","email_verified":true,"name":"Prince"}`, "a", "Prince", "", "token-nick", false},
+		{"only missing cosmetics use token", `{"sub":"abc","email":"a@b.com","email_verified":true,"given_name":"Real"}`, "a", "Real", "", "token-nick", false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			user, err := p.GetUserFromJSON(rctx, strings.NewReader(tc.body), tokenUser, &model.SSOSettings{UsePreferredUsername: model.NewPointer(tc.preferred)})
+			require.NoError(t, err)
+			assert.Equal(t, "abc", *user.AuthData)
+			assert.Equal(t, tc.username, user.Username)
+			assert.Equal(t, tc.first, user.FirstName)
+			assert.Equal(t, tc.last, user.LastName)
+			assert.Equal(t, tc.nickname, user.Nickname)
+			assert.Equal(t, strings.ToLower(user.Email), user.Email)
+			assert.NotEqual(t, tokenUser.Email, user.Email)
+			assert.Empty(t, user.AuthService, "the caller sets the service")
+		})
+	}
+	for _, body := range []string{
+		`{"email":"a@b.com","email_verified":true}`,
+		`{"sub":"abc","email_verified":true}`,
+		`{"sub":"abc","email":"invalid","email_verified":true}`,
+		`{"sub":"other","email":"a@b.com","email_verified":true}`,
+		`{"sub":" abc ","email":"a@b.com","email_verified":true}`,
+		`not json`,
+		`{"sub":"abc","email":"a@b.com","email_verified":true} {}`,
+		`{"sub":"abc","email":"a@b.com","email_verified":true}` + strings.Repeat(" ", maxUserInfoSize),
+	} {
+		_, err := p.GetUserFromJSON(rctx, strings.NewReader(body), tokenUser, nil)
+		require.Error(t, err)
+	}
+	for _, token := range []*model.User{nil, {}, {AuthData: model.NewPointer("")}} {
+		_, err := p.GetUserFromJSON(rctx, strings.NewReader(`{"sub":"abc","email":"a@b.com","email_verified":true}`), token, nil)
+		require.ErrorContains(t, err, "validated ID token")
+	}
+}
+
+func TestEmailVerifiedClaim(t *testing.T) {
+	p := New()
+	rctx := request.TestContext(t)
+	token := &model.User{AuthData: model.NewPointer("abc")}
+	for _, claim := range []string{`true`, `false`, `null`, `"true"`, `"TRUE"`, `"t"`, `1`, `-1`, `"1"`, `0`, `"false"`, `""`, `"maybe"`, `{}`, `[]`} {
+		t.Run(claim, func(t *testing.T) {
+			_, err := p.GetUserFromJSON(rctx, strings.NewReader(`{"sub":"abc","email":"a@b.com","email_verified":`+claim+`}`), token, nil)
+			if claim == "true" {
+				require.NoError(t, err)
+			} else {
+				require.ErrorContains(t, err, "email_verified")
+			}
+		})
+	}
+	_, err := p.GetUserFromJSON(rctx, strings.NewReader(`{"sub":"abc","email":"a@b.com"}`), token, nil)
+	require.ErrorContains(t, err, "email_verified")
+}
+
+func TestSubjectClaim(t *testing.T) {
+	p := New()
+	rctx := request.TestContext(t)
+	for _, subject := range []string{"abc", "12345", "  abc  ", strings.Repeat("a", 255)} {
+		body := fmt.Sprintf(`{"sub":%q,"email":"a@b.com","email_verified":true}`, subject)
+		user, err := p.GetUserFromJSON(rctx, strings.NewReader(body), &model.User{AuthData: &subject}, nil)
+		require.NoError(t, err)
+		require.Equal(t, subject, *user.AuthData, "opaque subjects must not be normalized")
+	}
+	for _, sub := range []string{`12345`, `123456789012345678901234567890`, `{"id":"abc"}`, `["abc"]`, `true`, `null`, `""`, `"   "`, `"\u00e9"`, `"` + strings.Repeat("a", 256) + `"`} {
+		_, err := p.GetUserFromJSON(rctx, strings.NewReader(`{"sub":`+sub+`,"email":"a@b.com","email_verified":true}`), &model.User{AuthData: model.NewPointer("abc")}, nil)
+		require.Error(t, err)
+	}
+}
+
+func TestUsernameDerivation(t *testing.T) {
+	rctx := request.TestContext(t)
+	preferred := &model.SSOSettings{UsePreferredUsername: model.NewPointer(true)}
+	for _, tc := range []struct {
+		user     OpenIDUser
+		settings *model.SSOSettings
+		expected string
+	}{
+		{OpenIDUser{Subject: "1", Email: "jane.doe@example.com"}, nil, "jane.doe"},
+		{OpenIDUser{Subject: "1", Email: "a@b.com", PreferredUsername: "Jane.Doe"}, preferred, "jane.doe"},
+		{OpenIDUser{Subject: "1", PreferredUsername: "jane@example.com"}, preferred, "jane"},
+		{OpenIDUser{Subject: "1", Email: "jane+tag(x)@example.com"}, nil, "jane-tag-x"},
+		{OpenIDUser{Subject: "1", Email: "JANE@example.com"}, nil, "jane"},
+		{OpenIDUser{Subject: "1", Name: "Jane Doe"}, nil, "jane-doe"},
+		{OpenIDUser{Subject: "1", PreferredUsername: "jdoe"}, nil, "jdoe"},
+		{OpenIDUser{Subject: "1", Nickname: "janey"}, nil, "janey"},
+		{OpenIDUser{Subject: "abc-123"}, nil, "abc-123"},
+	} {
+		assert.Equal(t, tc.expected, usernameFrom(rctx.Logger(), &tc.user, tc.settings))
+	}
+	assert.True(t, model.IsValidUsername(usernameFrom(rctx.Logger(), &OpenIDUser{Subject: "!!!"}, nil)))
+}
+
+func TestIsSameUser(t *testing.T) {
+	p := New()
+	rctx := request.TestContext(t)
+	user := &model.User{AuthData: model.NewPointer("a"), AuthService: model.ServiceOpenid}
+	assert.True(t, p.IsSameUser(rctx, user, user))
+	for _, other := range []*model.User{nil, {}, {AuthData: model.NewPointer("")}, {AuthService: model.ServiceOpenid, AuthData: model.NewPointer("b")}} {
+		assert.False(t, p.IsSameUser(rctx, user, other))
+		assert.False(t, p.IsSameUser(rctx, other, user))
+	}
+	for _, service := range []string{model.UserAuthServiceLdap, model.UserAuthServiceSaml, model.ServiceGoogle, model.ServiceGitlab, ""} {
+		assert.False(t, p.IsSameUser(rctx, &model.User{AuthData: model.NewPointer("a"), AuthService: service}, user))
+	}
+}
+
+func configureSSO(cfg *model.Config, service, issuer string) {
+	s := cfg.GetSSOService(service)
+	*s.Enable = true
+	*s.Id = "client-id"
+	*s.Secret = "client-secret"
+	*s.Scope = "openid profile email"
+	*s.DiscoveryEndpoint = issuer
+}
+
+func TestGetSSOSettings(t *testing.T) {
+	for _, service := range []string{model.ServiceOpenid, model.ServiceGitlab, model.ServiceGoogle, model.ServiceOffice365} {
+		t.Run(service, func(t *testing.T) {
+			var hits atomic.Int64
+			var server *httptest.Server
+			server = httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				hits.Add(1)
+				assert.Equal(t, wellKnownPath, r.URL.Path)
+				_, _ = w.Write([]byte(discoveryBody(server.URL)))
+			}))
+			defer server.Close()
+			cfg := testConfig(server)
+			configureSSO(cfg, service, server.URL)
+			configured := cfg.GetSSOService(service)
+			if service == model.ServiceOpenid || service == model.ServiceGitlab {
+				*configured.AuthEndpoint = "https://legacy.invalid/auth"
+				*configured.TokenEndpoint = "https://legacy.invalid/token"
+				*configured.UserAPIEndpoint = "https://legacy.invalid/user"
+			}
+			// Google/Office keep the prepopulated legacy endpoints during this test.
+			oldAuth, oldToken, oldUser := *configured.AuthEndpoint, *configured.TokenEndpoint, *configured.UserAPIEndpoint
+			p := NewWithHTTPService(newTestHTTPService(cfg, server))
+			for range 2 {
+				settings, err := p.GetSSOSettings(request.TestContext(t), cfg, service)
+				require.NoError(t, err)
+				assert.Equal(t, server.URL+"/auth", *settings.AuthEndpoint)
+				assert.Equal(t, server.URL+"/token", *settings.TokenEndpoint)
+				assert.Equal(t, server.URL+"/userinfo", *settings.UserAPIEndpoint)
+			}
+			assert.EqualValues(t, 1, hits.Load())
+			assert.Equal(t, oldAuth, *configured.AuthEndpoint)
+			assert.Equal(t, oldToken, *configured.TokenEndpoint)
+			assert.Equal(t, oldUser, *configured.UserAPIEndpoint)
+		})
+	}
+
+	for _, tc := range []struct {
+		name, expected string
+		change         func(*model.Config)
+	}{
+		{"disabled", "not enabled", func(c *model.Config) { *c.OpenIdSettings.Enable = false }},
+		{"missing client ID", "Id", func(c *model.Config) { *c.OpenIdSettings.Id = "" }},
+		{"missing secret", "Secret", func(c *model.Config) { *c.OpenIdSettings.Secret = "" }},
+		{"manual endpoints only", "requires DiscoveryEndpoint", func(c *model.Config) {
+			*c.OpenIdSettings.DiscoveryEndpoint = ""
+			*c.OpenIdSettings.AuthEndpoint = "https://idp.example/auth"
+			*c.OpenIdSettings.TokenEndpoint = "https://idp.example/token"
+			*c.OpenIdSettings.UserAPIEndpoint = "https://idp.example/userinfo"
+		}},
+		{"missing openid scope", "openid scope", func(c *model.Config) { *c.OpenIdSettings.Scope = "notopenid email" }},
+		{"HTTP discovery", "https", func(c *model.Config) { *c.OpenIdSettings.DiscoveryEndpoint = "http://idp.example" }},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			cfg := testConfig()
+			configureSSO(cfg, model.ServiceOpenid, "https://idp.invalid")
+			tc.change(cfg)
+			_, err := New().GetSSOSettings(request.TestContext(t), cfg, model.ServiceOpenid)
+			require.ErrorContains(t, err, tc.expected)
+		})
+	}
+	_, err := New().GetSSOSettings(request.TestContext(t), testConfig(), model.UserAuthServiceSaml)
+	require.ErrorContains(t, err, "not handled")
+
+	t.Run("discovery failure", func(t *testing.T) {
+		server := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) { w.WriteHeader(http.StatusNotFound) }))
+		defer server.Close()
+		cfg := testConfig(server)
+		configureSSO(cfg, model.ServiceOpenid, server.URL)
+		_, err := NewWithHTTPService(newTestHTTPService(cfg, server)).GetSSOSettings(request.TestContext(t), cfg, model.ServiceOpenid)
+		require.ErrorContains(t, err, "404")
+	})
+}
