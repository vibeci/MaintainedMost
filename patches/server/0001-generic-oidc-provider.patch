+func TestMaintainedMostOIDCConcurrentClients(t *testing.T) {
+	var idp *httptest.Server
+	idp = httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		if strings.HasSuffix(r.URL.Path, "/.well-known/openid-configuration") {
+			realm := strings.TrimSuffix(r.URL.Path, "/.well-known/openid-configuration")
+			assert.NoError(t, json.NewEncoder(w).Encode(map[string]string{"issuer": idp.URL + realm, "authorization_endpoint": idp.URL + realm + "/authorize", "token_endpoint": idp.URL + realm + "/token", "userinfo_endpoint": idp.URL + realm + "/userinfo"}))
+			return
+		}
+		if strings.HasSuffix(r.URL.Path, "/token") {
+			clientID, secret, ok := r.BasicAuth()
+			assert.True(t, ok)
+			assert.Equal(t, "secret-"+clientID, secret)
+			realm := strings.TrimSuffix(r.URL.Path, "/token")
+			claims := jwt.MapClaims{"iss": idp.URL + realm, "aud": clientID, "sub": clientID, "iat": time.Now().Unix(), "exp": time.Now().Add(time.Hour).Unix()}
+			signed, err := jwt.NewWithClaims(jwt.SigningMethodHS256, claims).SignedString([]byte("fixture-key"))
+			assert.NoError(t, err)
+			assert.NoError(t, json.NewEncoder(w).Encode(map[string]string{"token_type": "Bearer", "access_token": clientID, "id_token": signed}))
+			return
+		}
+		clientID := strings.TrimPrefix(r.Header.Get("Authorization"), "Bearer ")
+		assert.NoError(t, json.NewEncoder(w).Encode(map[string]any{"sub": clientID, "email": clientID + "@example.com", "email_verified": true}))
+	}))
+	defer idp.Close()
+	roots := x509.NewCertPool()
+	roots.AddCert(idp.Certificate())
+	const count = 30
+	apps := make([]*App, count)
+	stores := make([]*storemocks.Store, count)
+	for i := range count {
+		cfg := &model.Config{}
+		cfg.SetDefaults()
+		*cfg.ServiceSettings.AllowedUntrustedInternalConnections = "127.0.0.1"
+		*cfg.OpenIdSettings.Enable = true
+		*cfg.OpenIdSettings.Id = fmt.Sprintf("client-%d", i)
+		*cfg.OpenIdSettings.Secret = "secret-" + *cfg.OpenIdSettings.Id
+		*cfg.OpenIdSettings.DiscoveryEndpoint = fmt.Sprintf("%s/realm-%d", idp.URL, i%2)
+		apps[i], stores[i] = newMaintainedMostOIDCApp(t, cfg, roots)
+	}
+	previous := einterfaces.GetOAuthProvider(model.ServiceOpenid)
+	einterfaces.RegisterOAuthProvider(model.ServiceOpenid, oauthopenid.NewWithHTTPService(apps[0].HTTPService()))
+	defer einterfaces.RegisterOAuthProvider(model.ServiceOpenid, previous)
+	var wg sync.WaitGroup
+	for i := range count {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			body, _, tokenUser, appErr := maintainedmostOIDCCallback(t, apps[i], stores[i], model.ServiceOpenid, false)
+			if !assert.Nil(t, appErr) {
+				return
+			}
+			defer body.Close()
+			assert.Equal(t, fmt.Sprintf("client-%d", i), *tokenUser.AuthData)
+			data, err := io.ReadAll(body)
+			assert.NoError(t, err)
+			assert.True(t, bytes.Contains(data, []byte(fmt.Sprintf(`"sub":"client-%d"`, i))))
+		}()
+	}
+	wg.Wait()
+}
diff --git a/server/channels/app/oauthproviders/openid/discovery.go b/server/channels/app/oauthproviders/openid/discovery.go
new file mode 100644
index 00000000..1b80a124
--- /dev/null
+++ b/server/channels/app/oauthproviders/openid/discovery.go
@@ -0,0 +1,259 @@
+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+package oauthopenid
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"net/url"
+	"strings"
+	"sync"
+	"time"
+
+	"golang.org/x/sync/singleflight"
+
+	"github.com/mattermost/mattermost/server/public/shared/mlog"
+	"github.com/mattermost/mattermost/server/public/shared/request"
+)
+
+const (
+	// discoveryTTL is how long a successfully fetched discovery document is
+	// reused. Discovery documents change rarely, and re-fetching one on every
+	// login would put the identity provider in the critical path twice.
+	discoveryTTL = time.Hour
+
+	// discoveryFailureTTL is how long a failed fetch is remembered. It is short
+	// so that a transient outage of the identity provider does not keep logins
+	// broken for long, but long enough that a provider which is down does not
+	// get a request per login attempt.
+	discoveryFailureTTL = 30 * time.Second
+
+	// discoveryTimeout bounds the whole discovery request.
+	discoveryTimeout = 10 * time.Second
+
+	// maxDiscoverySize bounds the discovery document we are willing to read.
+	maxDiscoverySize = 1 << 20 // 1MB
+
+	maxOIDCRedirects = 5
+
+	// wellKnownPath is appended when the configured endpoint is a bare issuer
+	// URL, as described by OpenID Connect Discovery 1.0, section 4.
+	wellKnownPath = "/.well-known/openid-configuration"
+)
+
+// discoveryDocument holds the subset of the OpenID Connect provider metadata
+// that Mattermost needs.
+type discoveryDocument struct {
+	Issuer                   string   `json:"issuer"`
+	AuthorizationEndpoint    string   `json:"authorization_endpoint"`
+	TokenEndpoint            string   `json:"token_endpoint"`
+	UserInfoEndpoint         string   `json:"userinfo_endpoint"`
+	TokenEndpointAuthMethods []string `json:"token_endpoint_auth_methods_supported"`
+}
+
+// Pin the full issuer, including its realm/path, before trusting endpoints.
+func (d *discoveryDocument) IsValid(expectedIssuer string) error {
+	if d.Issuer == "" {
+		return errors.New("the discovery document has no issuer")
+	}
+
+	_, err := validateHTTPSURL(d.Issuer)
+	if err != nil {
+		return fmt.Errorf("the issuer of the discovery document is invalid: %w", err)
+	}
+
+	if d.Issuer != expectedIssuer {
+		return fmt.Errorf("the discovery issuer %q does not match the configured issuer %q; set DiscoveryEndpoint to the exact issuer URL, including any trailing slash", d.Issuer, expectedIssuer)
+	}
+
+	for _, endpoint := range []struct {
+		name  string
+		value string
+	}{
+		{"authorization_endpoint", d.AuthorizationEndpoint},
+		{"token_endpoint", d.TokenEndpoint},
+		{"userinfo_endpoint", d.UserInfoEndpoint},
+	} {
+		if endpoint.value == "" {
+			return fmt.Errorf("the discovery document has no %s", endpoint.name)
+		}
+		if _, err := validateHTTPSURL(endpoint.value); err != nil {
+			return fmt.Errorf("the %s of the discovery document is invalid: %w", endpoint.name, err)
+		}
+	}
+
+	return nil
+}
+
+type discoveryEntry struct {
+	document  *discoveryDocument
+	err       error
+	expiresAt time.Time
+}
+
+type discoveryCache struct {
+	mut     sync.Mutex
+	entries map[string]discoveryEntry
+	group   singleflight.Group
+	now     func() time.Time
+}
+
+func newDiscoveryCache() *discoveryCache {
+	return &discoveryCache{
+		entries: make(map[string]discoveryEntry),
+		now:     time.Now,
+	}
+}
+
+// get returns the discovery document for the given endpoint, fetching it only
+// when there is no unexpired cached copy. Concurrent callers for the same
+// endpoint share a single fetch instead of queueing behind a lock, and failures
+// are cached briefly so that a provider which is down is not hammered.
+func (c *discoveryCache) get(rctx request.CTX, endpoint, networkPolicy string, client *http.Client) (*discoveryDocument, error) {
+	parsed, issuer, err := discoveryURL(endpoint)
+	if err != nil {
+		return nil, err
+	}
+	// Do not share a fetch (including cached failures) across issuers or
+	// outbound policies. No request installs its config on the shared provider.
+	key := parsed.String() + "\x00" + issuer + "\x00" + networkPolicy
+
+	if entry, ok := c.lookup(key); ok {
+		return entry.document, entry.err
+	}
+
+	result, err, _ := c.group.Do(key, func() (any, error) {
+		// Another caller may have filled the cache while this call was queued.
+		if entry, ok := c.lookup(key); ok {
+			return entry.document, entry.err
+		}
+
+		doc, err := c.fetch(rctx, parsed, issuer, client)
+		if !errors.Is(err, context.Canceled) {
+			c.store(key, doc, err)
+		}
+
+		return doc, err
+	})
+	if err != nil {
+		return nil, err
+	}
+
+	doc, _ := result.(*discoveryDocument)
+	if doc == nil {
+		return nil, errors.New("the discovery document could not be resolved")
+	}
+
+	return doc, nil
+}
+
+func (c *discoveryCache) lookup(key string) (discoveryEntry, bool) {
+	c.mut.Lock()
+	defer c.mut.Unlock()
+
+	entry, ok := c.entries[key]
+	if !ok || !c.now().Before(entry.expiresAt) {
+		return discoveryEntry{}, false
+	}
+
+	return entry, true
+}
+
+func (c *discoveryCache) store(key string, doc *discoveryDocument, err error) {
+	ttl := discoveryTTL
+	if err != nil {
+		ttl = discoveryFailureTTL
+	}
+
+	c.mut.Lock()
+	defer c.mut.Unlock()
+
+	c.entries[key] = discoveryEntry{document: doc, err: err, expiresAt: c.now().Add(ttl)}
+}
+
+func (c *discoveryCache) fetch(rctx request.CTX, target *url.URL, issuer string, client *http.Client) (*discoveryDocument, error) {
+	ctx, cancel := context.WithTimeout(rctx.Context(), discoveryTimeout)
+	defer cancel()
+
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, target.String(), nil)
+	if err != nil {
+		return nil, err
+	}
+	req.Header.Set("Accept", "application/json")
+
+	rctx.Logger().Debug("Fetching OpenID Connect discovery document", mlog.String("url", target.String()))
+
+	resp, err := client.Do(req)
+	if err != nil {
+		return nil, err
+	}
+	defer resp.Body.Close()
+
+	if resp.StatusCode != http.StatusOK {
+		return nil, fmt.Errorf("the discovery endpoint returned status %d", resp.StatusCode)
+	}
+
+	body, err := readBounded(resp.Body, maxDiscoverySize)
+	if err != nil {
+		return nil, err
+	}
+	var doc discoveryDocument
+	if err = json.Unmarshal(body, &doc); err != nil {
+		return nil, fmt.Errorf("unable to decode the discovery document: %w", err)
+	}
+
+	if err = doc.IsValid(issuer); err != nil {
+		return nil, err
+	}
+
+	return &doc, nil
+}
+
+// A bare issuer preserves its exact spelling, including a trailing slash.
+// A standard discovery URL pins the issuer obtained by removing the suffix.
+func discoveryURL(endpoint string) (*url.URL, string, error) {
+	parsed, err := validateHTTPSURL(endpoint)
+	if err != nil {
+		return nil, "", fmt.Errorf("the discovery endpoint is invalid: %w", err)
+	}
+	if parsed.RawQuery != "" || parsed.ForceQuery {
+		return nil, "", errors.New("the discovery endpoint or issuer must not contain a query")
+	}
+
+	// URL parsing normalizes the scheme. Issuers are case-sensitive identifiers,
+	// so retain their configured spelling separately from the transport URL.
+	issuer := strings.TrimSpace(endpoint)
+	if strings.HasSuffix(issuer, wellKnownPath) {
+		return parsed, strings.TrimSuffix(issuer, wellKnownPath), nil
+	}
+	if strings.Contains(parsed.Path, "/.well-known/") {
+		return nil, "", errors.New("DiscoveryEndpoint must be an issuer URL or end in /.well-known/openid-configuration")
+	}
+	target, err := url.Parse(strings.TrimSuffix(issuer, "/") + wellKnownPath)
+	return target, issuer, err
+}
+
+// Redirect and certificate policy is enforced separately by newHTTPClient.
+func validateHTTPSURL(raw string) (*url.URL, error) {
+	parsed, err := url.Parse(strings.TrimSpace(raw))
+	if err != nil {
+		return nil, err
+	}
+
+	if parsed.Scheme != "https" {
+		return nil, fmt.Errorf("the URL must use https, got scheme %q", parsed.Scheme)
+	}
+
+	if parsed.Hostname() == "" {
+		return nil, errors.New("the URL has no host")
+	}
+	if parsed.User != nil || parsed.Fragment != "" || strings.Contains(raw, "#") {
+		return nil, errors.New("the URL must not contain user credentials or a fragment")
+	}
+
+	return parsed, nil
+}
