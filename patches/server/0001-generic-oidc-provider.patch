+func TestMaintainedMostOIDCConnectionsClosed(t *testing.T) {
+	for _, tokenError := range []bool{false, true} {
+		t.Run(fmt.Sprintf("token_error=%t", tokenError), func(t *testing.T) {
+			var opened atomic.Int64
+			closed := make(chan struct{}, 8)
+			var idp *httptest.Server
+			idp = httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				assert.Equal(t, 1, r.ProtoMajor)
+				w.Header().Set("Content-Type", "application/json")
+				switch r.URL.Path {
+				case "/.well-known/openid-configuration":
+					assert.NoError(t, json.NewEncoder(w).Encode(map[string]string{"issuer": idp.URL, "authorization_endpoint": idp.URL + "/authorize", "token_endpoint": idp.URL + "/token", "userinfo_endpoint": idp.URL + "/userinfo"}))
+				case "/token":
+					if tokenError {
+						w.WriteHeader(http.StatusBadRequest)
+						assert.NoError(t, json.NewEncoder(w).Encode(map[string]string{"error": "invalid_grant"}))
+						return
+					}
+					claims := jwt.MapClaims{"iss": idp.URL, "aud": "client", "sub": "person", "iat": time.Now().Unix(), "exp": time.Now().Add(time.Hour).Unix()}
+					signed, err := jwt.NewWithClaims(jwt.SigningMethodHS256, claims).SignedString([]byte("fixture-key"))
+					assert.NoError(t, err)
+					assert.NoError(t, json.NewEncoder(w).Encode(map[string]string{"access_token": "access", "token_type": "Bearer", "id_token": signed}))
+				case "/userinfo":
+					assert.NoError(t, json.NewEncoder(w).Encode(map[string]any{"sub": "person", "email": "person@example.com", "email_verified": true}))
+				default:
+					t.Errorf("unexpected path %s", r.URL.Path)
+				}
+			}))
+			idp.EnableHTTP2 = false
+			idp.Config.ConnState = func(_ net.Conn, state http.ConnState) {
+				switch state {
+				case http.StateNew:
+					opened.Add(1)
+				case http.StateClosed:
+					closed <- struct{}{}
+				}
+			}
+			idp.StartTLS()
+			defer idp.Close()
+			cfg := &model.Config{}
+			cfg.SetDefaults()
+			*cfg.ServiceSettings.AllowedUntrustedInternalConnections = "127.0.0.1"
+			*cfg.OpenIdSettings.Enable = true
+			*cfg.OpenIdSettings.Id = "client"
+			*cfg.OpenIdSettings.Secret = "secret"
+			*cfg.OpenIdSettings.DiscoveryEndpoint = idp.URL
+			roots := x509.NewCertPool()
+			roots.AddCert(idp.Certificate())
+			a, st := newMaintainedMostOIDCApp(t, cfg, roots)
+			previous := einterfaces.GetOAuthProvider(model.ServiceOpenid)
+			einterfaces.RegisterOAuthProvider(model.ServiceOpenid, oauthopenid.NewWithHTTPService(a.HTTPService()))
+			defer einterfaces.RegisterOAuthProvider(model.ServiceOpenid, previous)
+			body, _, _, appErr := maintainedmostOIDCCallback(t, a, st, model.ServiceOpenid, false)
+			if tokenError {
+				require.ErrorContains(t, appErr, "HTTP 400")
+			} else {
+				require.Nil(t, appErr)
+				require.NoError(t, body.Close())
+			}
+			// Small responses are consumed completely, making both discovery and
+			// exchange sockets reusable. Wait for actual close events, not idle
+			// expiration or an arbitrary sleep. The deadline only bounds failures.
+			require.EqualValues(t, 2, opened.Load())
+			ctx, cancel := context.WithTimeout(t.Context(), 5*time.Second)
+			defer cancel()
+			for range opened.Load() {
+				select {
+				case <-closed:
+				case <-ctx.Done():
+					t.Fatal("OIDC transports retained idle connections after the callback returned")
+				}
+			}
+		})
+	}
+}
+
