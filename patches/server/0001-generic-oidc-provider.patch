index 00000000..2c8f5d68
--- /dev/null
+++ b/server/channels/app/oauthproviders/openid/idtoken.go
@@ -0,0 +1,86 @@
+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+package oauthopenid
+
+import (
+	"encoding/base64"
+	"errors"
+	"fmt"
+	"strings"
+	"time"
+
+	"github.com/golang-jwt/jwt/v5"
+)
+
+const (
+	// maxIDTokenSize bounds the compact serialization we are willing to parse.
+	maxIDTokenSize = 64 * 1024
+
+	// clockSkew is the tolerance applied to the time based claims.
+	clockSkew = 2 * time.Minute
+)
+
+type idTokenClaims struct {
+	jwt.RegisteredClaims
+	AuthorizedParty *string `json:"azp"`
+	Name            string  `json:"name"`
+	GivenName       string  `json:"given_name"`
+	FamilyName      string  `json:"family_name"`
+	Nickname        string  `json:"nickname"`
+}
+
+// Only Exchange calls this, with the ID token obtained from its authenticated
+// TLS token response and request-local discovery issuer/client ID. OIDC Core
+// 3.1.3.7 permits TLS authentication instead of JWS signature verification in
+// this code flow. This is NOT a verifier for browser-supplied or stored tokens.
+func parseIDToken(idToken, issuer, clientID string, now time.Time) (*idTokenClaims, error) {
+	if idToken == "" {
+		return nil, errors.New("the token endpoint must return an ID token")
+	}
+	if len(idToken) > maxIDTokenSize {
+		return nil, errors.New("the ID token is too large")
+	}
+	if issuer == "" || clientID == "" {
+		return nil, errors.New("the expected issuer and client ID are required")
+	}
+
+	var claims idTokenClaims
+	token, parts, err := jwt.NewParser(jwt.WithJSONNumber()).ParseUnverified(idToken, &claims)
+	if err != nil {
+		return nil, fmt.Errorf("unable to decode the ID token: %w", err)
+	}
+	if token.Method.Alg() == "none" || parts[2] == "" {
+		return nil, errors.New("the ID token must use a signed JWS")
+	}
+	if _, err := base64.RawURLEncoding.DecodeString(parts[2]); err != nil {
+		return nil, fmt.Errorf("the ID token signature is malformed: %w", err)
+	}
+	if err := validateSubject(claims.Subject); err != nil {
+		return nil, err
+	}
+	if claims.IssuedAt == nil {
+		return nil, errors.New("the ID token has no iat claim")
+	}
+
+	validator := jwt.NewValidator(jwt.WithIssuer(issuer), jwt.WithAudience(clientID),
+		jwt.WithExpirationRequired(), jwt.WithIssuedAt(), jwt.WithLeeway(clockSkew),
+		jwt.WithTimeFunc(func() time.Time { return now }))
+	if err := validator.Validate(&claims); err != nil {
+		return nil, fmt.Errorf("the ID token claims are invalid: %w", err)
+	}
+	if !claims.ExpiresAt.After(claims.IssuedAt.Time) {
+		return nil, errors.New("the ID token exp must be after iat")
+	}
+	if len(claims.Audience) > 1 && claims.AuthorizedParty == nil {
+		return nil, errors.New("an ID token with multiple audiences must have an azp claim")
+	}
+	if claims.AuthorizedParty != nil && *claims.AuthorizedParty != clientID {
+		return nil, errors.New("the ID token azp does not match the client ID")
+	}
+	if strings.ContainsAny(idToken, " \t\r\n") {
+		return nil, errors.New("the ID token must not contain whitespace")
+	}
+
+	return &claims, nil
+}
