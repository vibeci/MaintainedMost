+
+type maintainedmostOIDCConfig struct {
+	configService
+	cfg *model.Config
+}
+
+func (c *maintainedmostOIDCConfig) Config() *model.Config { return c.cfg }
+
+// Add only fixture trust roots. Production code must still override insecure
+// TLS and enforce redirect/address policy on the resulting real transport.
+type maintainedmostOIDCHTTPService struct {
+	httpservice.HTTPService
+	roots *x509.CertPool
+}
+
+func (s *maintainedmostOIDCHTTPService) MakeClient(trustURLs bool) *http.Client {
+	c := s.HTTPService.MakeClient(trustURLs)
+	c.Transport.(*httpservice.MattermostTransport).Transport.(*http.Transport).TLSClientConfig.RootCAs = s.roots
+	return c
+}
+
+func newMaintainedMostOIDCApp(t *testing.T, cfg *model.Config, roots *x509.CertPool) (*App, *storemocks.Store) {
+	t.Helper()
+	st := &storemocks.Store{}
+	ps := &platform.PlatformService{Store: st}
+	ps.SetLogger(mlog.CreateConsoleTestLogger(t))
+	cs := &maintainedmostOIDCConfig{cfg: cfg}
+	srv := &Server{platform: ps, httpService: &maintainedmostOIDCHTTPService{HTTPService: httpservice.MakeHTTPService(cs), roots: roots}}
+	a := &App{ch: &Channels{srv: srv, cfgSvc: cs}}
+	return a, st
+}
+
+func maintainedmostOIDCCallback(t *testing.T, a *App, st *storemocks.Store, service string, badCookie bool) (io.ReadCloser, map[string]string, *model.User, *model.AppError) {
+	t.Helper()
+	token := model.NewToken(model.TokenTypeOAuth, generateOAuthStateTokenExtra("", model.OAuthActionLogin, "fixture-cookie"))
+	tokens := &storemocks.TokenStore{}
+	tokens.On("GetByToken", token.Token).Return(token, nil).Maybe()
+	tokens.On("Delete", token.Token).Return(nil).Maybe()
+	st.On("Token").Return(tokens)
+	props := map[string]string{"token": token.Token, "action": model.OAuthActionLogin}
+	state := base64.StdEncoding.EncodeToString([]byte(model.MapToJSON(props)))
+	r := httptest.NewRequest(http.MethodGet, "https://mattermost.example/signup/"+service+"/complete", nil)
+	cookie := "fixture-cookie"
+	if badCookie {
+		cookie = "wrong-cookie"
+	}
+	r.AddCookie(&http.Cookie{Name: CookieOAuth, Value: cookie})
+	return a.AuthorizeOAuthUser(request.TestContext(t), httptest.NewRecorder(), r, service, "auth-code", state, "https://mattermost.example/signup/"+service+"/complete")
+}
+
+func TestMaintainedMostOIDCCallback(t *testing.T) {
+	for _, tc := range []struct {
+		name, service, transport, wantError string
+		claims                              func(jwt.MapClaims)
+		userinfo                            func(map[string]any)
+		issuer                              func(string) string
+		authMethods                         []string
+		wantTokenRequests                   int64
+		omitToken, secretPost, badCookie    bool
+	}{
+		{name: "valid signin", wantTokenRequests: 1},
+		{name: "Google defaults use discovery", service: model.ServiceGoogle},
+		{name: "Microsoft defaults use discovery", service: model.ServiceOffice365},
+		{name: "only client_secret_basic", authMethods: []string{"client_secret_basic"}, wantTokenRequests: 1},
+		{name: "only client_secret_post", authMethods: []string{"client_secret_post"}, secretPost: true, wantTokenRequests: 1},
+		{name: "both methods registered Basic", authMethods: []string{"client_secret_basic", "client_secret_post"}, wantTokenRequests: 1},
+		{name: "both methods registered POST", authMethods: []string{"client_secret_basic", "client_secret_post"}, secretPost: true, wantTokenRequests: 2},
+		{name: "unsupported authentication method", authMethods: []string{"private_key_jwt"}, wantError: "must support"},
+		{name: "uppercase issuer scheme", issuer: func(base string) string { return strings.Replace(base, "https:", "HTTPS:", 1) + "/realm" }},
+		{name: "encoded case-sensitive issuer path", issuer: func(base string) string { return base + "/ReAlM/%4dM" }},
+		{name: "issuer scheme is not normalized", issuer: func(base string) string { return strings.Replace(base, "https:", "HTTPS:", 1) + "/realm" }, claims: func(c jwt.MapClaims) { c["iss"] = strings.Replace(c["iss"].(string), "HTTPS:", "https:", 1) }, wantError: "claims are invalid"},
+		{name: "issuer encoding is not normalized", issuer: func(base string) string { return base + "/ReAlM/%4dM" }, claims: func(c jwt.MapClaims) { c["iss"] = strings.Replace(c["iss"].(string), "%4d", "%4D", 1) }, wantError: "claims are invalid"},
+		{name: "same-origin HTTPS token redirect", transport: "token same origin"},
+		{name: "same-origin HTTPS userinfo redirect", transport: "userinfo same origin"},
+		{name: "cookie mismatch", badCookie: true, wantError: "invalid_state"},
+		{name: "missing ID token", omitToken: true, wantError: "ID token"},
+		{name: "missing issuer", claims: func(c jwt.MapClaims) { delete(c, "iss") }, wantError: "claims are invalid"},
+		{name: "issuer path mixup", claims: func(c jwt.MapClaims) { c["iss"] = c["iss"].(string) + "/another-realm" }, wantError: "claims are invalid"},
+		{name: "missing audience", claims: func(c jwt.MapClaims) { delete(c, "aud") }, wantError: "claims are invalid"},
+		{name: "wrong audience", claims: func(c jwt.MapClaims) { c["aud"] = "other-client" }, wantError: "claims are invalid"},
+		{name: "multi audience missing azp", claims: func(c jwt.MapClaims) { c["aud"] = []string{"maintainedmost-client", "other"} }, wantError: "azp"},
+		{name: "multi audience wrong azp", claims: func(c jwt.MapClaims) { c["aud"] = []string{"maintainedmost-client", "other"}; c["azp"] = "other" }, wantError: "azp"},
+		{name: "multi audience valid azp", claims: func(c jwt.MapClaims) {
+			c["aud"] = []string{"maintainedmost-client", "other"}
+			c["azp"] = "maintainedmost-client"
+		}},
+		{name: "missing exp", claims: func(c jwt.MapClaims) { delete(c, "exp") }, wantError: "claims are invalid"},
+		{name: "missing iat", claims: func(c jwt.MapClaims) { delete(c, "iat") }, wantError: "iat"},
+		{name: "expired", claims: func(c jwt.MapClaims) { c["exp"] = time.Now().Add(-time.Hour).Unix() }, wantError: "claims are invalid"},
+		{name: "future iat", claims: func(c jwt.MapClaims) { c["iat"] = time.Now().Add(time.Hour).Unix() }, wantError: "claims are invalid"},
+		{name: "future nbf", claims: func(c jwt.MapClaims) { c["nbf"] = time.Now().Add(time.Hour).Unix() }, wantError: "claims are invalid"},
+		{name: "subject mismatch", userinfo: func(c map[string]any) { c["sub"] = "someone-else" }, wantError: "does not match"},
+		{name: "subject is not normalized", userinfo: func(c map[string]any) { c["sub"] = " person " }, wantError: "does not match"},
+		{name: "missing subject", userinfo: func(c map[string]any) { delete(c, "sub") }, wantError: "does not match"},
+		{name: "missing verified email", userinfo: func(c map[string]any) { delete(c, "email_verified") }, wantError: "email_verified"},
+		{name: "false verified email", userinfo: func(c map[string]any) { c["email_verified"] = false }, wantError: "email_verified"},
+		{name: "null verified email", userinfo: func(c map[string]any) { c["email_verified"] = nil }, wantError: "email_verified"},
+		{name: "string verified email", userinfo: func(c map[string]any) { c["email_verified"] = "true" }, wantError: "email_verified"},
+		{name: "numeric verified email", userinfo: func(c map[string]any) { c["email_verified"] = 1 }, wantError: "email_verified"},
+		{name: "no email fallback from ID token", userinfo: func(c map[string]any) { delete(c, "email") }, wantError: "email claim"},
+		{name: "bounded UserInfo before app buffers it", userinfo: func(c map[string]any) { c["padding"] = strings.Repeat("a", 1<<20) }, wantError: "exceeds"},
+		{name: "token HTTP downgrade", transport: "token HTTP", wantError: "https"},
+		{name: "userinfo HTTP downgrade", transport: "userinfo HTTP", wantError: "https"},
+		{name: "token cross-origin redirect", transport: "token cross origin", wantError: "different origin"},
+		{name: "userinfo cross-origin redirect", transport: "userinfo cross origin", wantError: "different origin"},
+		{name: "invalid discovery certificate despite insecure override", transport: "discovery certificate", wantError: "certificate"},
+		{name: "invalid token certificate despite insecure override", transport: "token certificate", wantError: "certificate"},
+		{name: "invalid userinfo certificate despite insecure override", transport: "userinfo certificate", wantError: "certificate"},
+		{name: "outbound policy on token endpoint", transport: "token outbound denied", wantError: "AllowedUntrustedInternalConnections"},
+		{name: "outbound policy on userinfo endpoint", transport: "userinfo outbound denied", wantError: "AllowedUntrustedInternalConnections"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			service := tc.service
+			if service == "" {
+				service = model.ServiceOpenid
+			}
+			var targetHits, tokenHits atomic.Int64
+			targetHandler := http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+				targetHits.Add(1)
+				w.WriteHeader(http.StatusInternalServerError)
+			})
+			target := httptest.NewTLSServer(targetHandler)
+			if strings.Contains(tc.transport, "HTTP") {
+				target.Close()
+				target = httptest.NewServer(targetHandler)
+			}
+			defer target.Close()
+			var idp *httptest.Server
+			issuer := func() string {
+				if tc.issuer != nil {
+					return tc.issuer(idp.URL)
+				}
+				return idp.URL + "/realm"
+			}
+			idp = httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.Header().Set("Content-Type", "application/json")
+				switch {
+				case strings.HasSuffix(r.URL.Path, "/.well-known/openid-configuration"):
+					tokenURL, userURL := idp.URL+"/token", idp.URL+"/userinfo"
+					if tc.transport == "token certificate" || tc.transport == "token outbound denied" {
+						tokenURL = strings.Replace(tokenURL, "127.0.0.1", "localhost", 1)
+					}
+					if tc.transport == "userinfo certificate" || tc.transport == "userinfo outbound denied" {
+						userURL = strings.Replace(userURL, "127.0.0.1", "localhost", 1)
+					}
+					doc := map[string]any{"issuer": issuer(), "authorization_endpoint": idp.URL + "/authorize", "token_endpoint": tokenURL, "userinfo_endpoint": userURL}
+					if tc.authMethods != nil {
+						doc["token_endpoint_auth_methods_supported"] = tc.authMethods
+					}
+					assert.NoError(t, json.NewEncoder(w).Encode(doc))
+				case r.URL.Path == "/token" || r.URL.Path == "/token-final":
+					tokenHits.Add(1)
+					assert.Equal(t, http.MethodPost, r.Method)
+					assert.Equal(t, "auth-code", r.FormValue("code"))
+					id, secret, basic := r.BasicAuth()
+					if basic {
+						assert.Equal(t, "maintainedmost-client", id)
+						assert.Equal(t, "fixture-secret", secret)
+					}
+					if tc.secretPost {
+						if basic {
+							w.WriteHeader(http.StatusUnauthorized)
+							assert.NoError(t, json.NewEncoder(w).Encode(map[string]string{"error": "invalid_client"}))
+							return
+						}
+						assert.Equal(t, "maintainedmost-client", r.FormValue("client_id"))
+						assert.Equal(t, "fixture-secret", r.FormValue("client_secret"))
+					} else {
+						assert.True(t, basic)
+					}
+					if tc.transport == "token HTTP" || tc.transport == "token cross origin" {
+						http.Redirect(w, r, target.URL, http.StatusTemporaryRedirect)
+						return
+					}
+					if tc.transport == "token same origin" && r.URL.Path == "/token" {
+						http.Redirect(w, r, idp.URL+"/token-final", http.StatusTemporaryRedirect)
+						return
+					}
+					claims := jwt.MapClaims{"iss": issuer(), "aud": "maintainedmost-client", "sub": "person", "exp": time.Now().Add(time.Hour).Unix(), "iat": time.Now().Add(-time.Minute).Unix(), "email": "jane@allowed.example", "email_verified": true}
+					if tc.claims != nil {
+						tc.claims(claims)
+					}
+					signed, err := jwt.NewWithClaims(jwt.SigningMethodHS256, claims).SignedString([]byte("fixture-signing-key"))
+					assert.NoError(t, err)
+					response := map[string]any{"access_token": "fixture-access-token", "token_type": "Bearer", "id_token": signed}
+					if tc.omitToken {
+						delete(response, "id_token")
+					}
+					assert.NoError(t, json.NewEncoder(w).Encode(response))
+				case r.URL.Path == "/userinfo" || r.URL.Path == "/userinfo-final":
+					assert.Equal(t, "Bearer fixture-access-token", r.Header.Get("Authorization"))
+					if tc.transport == "userinfo HTTP" || tc.transport == "userinfo cross origin" {
+						http.Redirect(w, r, target.URL, http.StatusTemporaryRedirect)
+						return
+					}
+					if tc.transport == "userinfo same origin" && r.URL.Path == "/userinfo" {
+						http.Redirect(w, r, idp.URL+"/userinfo-final", http.StatusTemporaryRedirect)
+						return
+					}
+					info := map[string]any{"sub": "person", "email": "jane@allowed.example", "email_verified": true, "given_name": "Jane", "family_name": "Doe"}
+					if tc.userinfo != nil {
+						tc.userinfo(info)
+					}
+					assert.NoError(t, json.NewEncoder(w).Encode(info))
+				default:
+					t.Errorf("unexpected IdP path %s", r.URL.Path)
+				}
+			}))
+			defer idp.Close()
+			cfg := &model.Config{}
+			cfg.SetDefaults()
+			*cfg.ServiceSettings.AllowedUntrustedInternalConnections = "127.0.0.1 localhost"
+			if strings.Contains(tc.transport, "outbound denied") {
+				*cfg.ServiceSettings.AllowedUntrustedInternalConnections = "127.0.0.1"
+			}
+			// Every transport case runs with the global insecure override enabled.
+			*cfg.ServiceSettings.EnableInsecureOutgoingConnections = true
+			sso := cfg.GetSSOService(service)
+			*sso.Enable = true
+			*sso.Id = "maintainedmost-client"
+			*sso.Secret = "fixture-secret"
+			*sso.Scope = "openid profile email"
+			*sso.DiscoveryEndpoint = issuer()
+			roots := x509.NewCertPool()
+			if tc.transport != "discovery certificate" {
+				roots.AddCert(idp.Certificate())
+			}
+			a, st := newMaintainedMostOIDCApp(t, cfg, roots)
+			p := oauthopenid.NewWithHTTPService(a.HTTPService())
+			previous := einterfaces.GetOAuthProvider(model.ServiceOpenid)
+			einterfaces.RegisterOAuthProvider(model.ServiceOpenid, p)
+			defer einterfaces.RegisterOAuthProvider(model.ServiceOpenid, previous)
+			body, props, tokenUser, appErr := maintainedmostOIDCCallback(t, a, st, service, tc.badCookie)
+			require.Zero(t, targetHits.Load(), "redirects must not forward credentials or codes across origins or onto HTTP")
+			if tc.wantTokenRequests != 0 {
+				require.Equal(t, tc.wantTokenRequests, tokenHits.Load())
+			}
+			if tc.wantError != "" {
+				require.NotNil(t, appErr)
+				if tc.badCookie {
+					require.Contains(t, appErr.Id, tc.wantError)
+					require.Zero(t, tokenHits.Load())
+				} else {
+					require.ErrorContains(t, appErr, tc.wantError)
+				}
+				require.Nil(t, body)
+				return
+			}
+			require.Nil(t, appErr)
+			require.Equal(t, "person", *tokenUser.AuthData)
+			// Complete a real existing-account login, with only DB access mocked.
+			dbUser := &model.User{Id: model.NewId(), AuthService: service, AuthData: model.NewPointer("person"), Email: "jane@allowed.example", EmailVerified: true, Username: "jane", FirstName: "Jane", LastName: "Doe", Roles: model.SystemUserRoleId}
+			us := &storemocks.UserStore{}
+			us.On("GetByAuth", mock.Anything, service).Return(dbUser, nil)
+			var err error
+			a.ch.srv.userService, err = users.New(users.ServiceConfig{UserStore: us, SessionStore: &storemocks.SessionStore{}, OAuthStore: &storemocks.OAuthStore{}, ConfigFn: a.Config, LicenseFn: func() *model.License { return nil }})
+			require.NoError(t, err)
+			user, appErr := a.CompleteOAuth(request.TestContext(t), service, body, props, tokenUser)
+			require.Nil(t, appErr)
+			require.Equal(t, dbUser.Id, user.Id)
+			us.AssertExpectations(t)
+		})
+	}
+}
