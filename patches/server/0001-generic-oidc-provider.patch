new file mode 100644
index 00000000..ca4e3c25
--- /dev/null
+++ b/server/channels/app/oauthproviders/openid/exchange.go
@@ -0,0 +1,157 @@
+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+package oauthopenid
+
+import (
+	"bytes"
+	"context"
+	"crypto/tls"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"slices"
+	"strings"
+	"time"
+
+	"golang.org/x/oauth2"
+
+	"github.com/mattermost/mattermost/server/public/model"
+	"github.com/mattermost/mattermost/server/public/shared/httpservice"
+	"github.com/mattermost/mattermost/server/public/shared/request"
+	"github.com/mattermost/mattermost/server/v8/einterfaces"
+)
+
+var _ einterfaces.OAuthCodeExchanger = (*OpenIDProvider)(nil)
+
+// Exchange owns all authentication context for this request. Neither resolved
+// settings nor token claims are stored on the shared provider.
+func (p *OpenIDProvider) Exchange(rctx request.CTX, config *model.Config, service, code, redirectURI string, httpService httpservice.HTTPService) (io.ReadCloser, *model.User, error) {
+	client, err := newHTTPClient(httpService)
+	if err != nil {
+		return nil, nil, err
+	}
+	defer client.CloseIdleConnections()
+	settings, discovery, err := p.resolveSettings(rctx, config, service, client)
+	if err != nil {
+		return nil, nil, err
+	}
+
+	// Discovery lists provider capabilities, not this client's registration.
+	// Let oauth2 negotiate when both methods are supported; omission defaults
+	// to client_secret_basic as specified by OIDC Discovery.
+	methods := discovery.TokenEndpointAuthMethods
+	basic := len(methods) == 0 || slices.Contains(methods, "client_secret_basic")
+	post := slices.Contains(methods, "client_secret_post")
+	authStyle := oauth2.AuthStyleInHeader
+	switch {
+	case basic && post:
+		authStyle = oauth2.AuthStyleAutoDetect
+	case post:
+		authStyle = oauth2.AuthStyleInParams
+	case !basic:
+		return nil, nil, errors.New("the OpenID provider must support client_secret_basic or client_secret_post")
+	}
+	oauthConfig := oauth2.Config{
+		ClientID:     *settings.Id,
+		ClientSecret: *settings.Secret,
+		RedirectURL:  redirectURI,
+		Endpoint: oauth2.Endpoint{
+			TokenURL:  *settings.TokenEndpoint,
+			AuthStyle: authStyle,
+		},
+	}
+	ctx := context.WithValue(rctx.Context(), oauth2.HTTPClient, client)
+	token, err := oauthConfig.Exchange(ctx, code)
+	if err != nil {
+		// RetrieveError includes the response body, which can contain tokens.
+		var responseErr *oauth2.RetrieveError
+		if errors.As(err, &responseErr) {
+			return nil, nil, fmt.Errorf("the OpenID token endpoint returned HTTP %d", responseErr.Response.StatusCode)
+		}
+		return nil, nil, fmt.Errorf("unable to exchange the OpenID authorization code: %w", err)
+	}
+	if !strings.EqualFold(token.TokenType, "Bearer") {
+		return nil, nil, errors.New("the OpenID token endpoint must return a Bearer access token")
+	}
+	idToken, _ := token.Extra("id_token").(string)
+	claims, err := parseIDToken(idToken, discovery.Issuer, *settings.Id, time.Now())
+	if err != nil {
+		return nil, nil, err
+	}
+	tokenUser := &model.User{AuthData: model.NewPointer(claims.Subject), Nickname: claims.Nickname}
+	tokenUser.FirstName, tokenUser.LastName = namesFrom(&OpenIDUser{
+		Name: claims.Name, GivenName: claims.GivenName, FamilyName: claims.FamilyName,
+	})
+
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, *settings.UserAPIEndpoint, nil)
+	if err != nil {
+		return nil, nil, err
+	}
+	req.Header.Set("Accept", "application/json")
+	token.SetAuthHeader(req)
+	resp, err := client.Do(req)
+	if err != nil {
+		return nil, nil, fmt.Errorf("unable to fetch OpenID userinfo: %w", err)
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusOK {
+		return nil, nil, fmt.Errorf("the OpenID userinfo endpoint returned HTTP %d", resp.StatusCode)
+	}
+	// Bound the body before App.LoginByOAuth buffers it, not just in the parser.
+	body, err := readBounded(resp.Body, maxUserInfoSize)
+	if err != nil {
+		return nil, nil, err
+	}
+	if _, err := p.GetUserFromJSON(rctx, bytes.NewReader(body), tokenUser, settings); err != nil {
+		return nil, nil, err
+	}
+	return io.NopCloser(bytes.NewReader(body)), tokenUser, nil
+}
+
+// Keep Mattermost's guarded dialer/proxy policy, but never inherit its global
+// insecure-TLS override. Clone transports so concurrent requests are isolated.
+func newHTTPClient(service httpservice.HTTPService) (*http.Client, error) {
+	client := *service.MakeClient(false)
+	guarded, ok := client.Transport.(*httpservice.MattermostTransport)
+	if !ok {
+		return nil, errors.New("OpenID Connect requires a guarded Mattermost HTTP transport")
+	}
+	transport, ok := guarded.Transport.(*http.Transport)
+	if !ok || transport.DialTLS != nil || transport.DialTLSContext != nil {
+		return nil, errors.New("OpenID Connect requires a TLS-verifying HTTP transport")
+	}
+	transport = transport.Clone()
+	if transport.TLSClientConfig == nil {
+		transport.TLSClientConfig = &tls.Config{}
+	}
+	transport.TLSClientConfig.InsecureSkipVerify = false
+	transport.TLSClientConfig.MinVersion = max(transport.TLSClientConfig.MinVersion, tls.VersionTLS12)
+	client.Transport = &httpservice.MattermostTransport{Transport: transport}
+	client.Timeout = httpservice.RequestTimeout
+	client.CheckRedirect = func(req *http.Request, via []*http.Request) error {
+		if len(via) >= maxOIDCRedirects {
+			return fmt.Errorf("stopped after %d OpenID redirects", maxOIDCRedirects)
+		}
+		if _, err := validateHTTPSURL(req.URL.String()); err != nil {
+			return fmt.Errorf("the OpenID endpoint redirected to an invalid URL: %w", err)
+		}
+		if !strings.EqualFold(req.URL.Host, via[0].URL.Host) {
+			return errors.New("the OpenID endpoint redirected to a different origin")
+		}
+		return nil
+	}
+	return &client, nil
+}
+
+func readBounded(reader io.Reader, limit int64) ([]byte, error) {
+	body, err := io.ReadAll(io.LimitReader(reader, limit+1))
+	if err != nil {
+		return nil, err
+	}
+	if int64(len(body)) > limit {
+		return nil, fmt.Errorf("the OpenID response exceeds %d bytes", limit)
+	}
+	return body, nil
+}
