+	"github.com/mattermost/mattermost/server/public/shared/httpservice"
+	"github.com/mattermost/mattermost/server/public/shared/request"
+)
+
+type testHTTPService struct {
+	httpservice.HTTPService
+	roots *x509.CertPool
+}
+
+func (s *testHTTPService) MakeClient(trustURLs bool) *http.Client {
+	client := s.HTTPService.MakeClient(trustURLs)
+	client.Transport.(*httpservice.MattermostTransport).Transport.(*http.Transport).TLSClientConfig.RootCAs = s.roots
+	return client
+}
+
+func newTestHTTPService(cfg *model.Config, servers ...*httptest.Server) *testHTTPService {
+	roots := x509.NewCertPool()
+	for _, server := range servers {
+		if server.TLS != nil {
+			roots.AddCert(server.Certificate())
+		}
+	}
+	return &testHTTPService{HTTPService: httpservice.MakeHTTPService(&requestConfig{config: cfg}), roots: roots}
+}
+
+func testConfig(servers ...*httptest.Server) *model.Config {
+	cfg := &model.Config{}
+	cfg.SetDefaults()
+	hosts := make([]string, 0, len(servers))
+	for _, server := range servers {
+		parsed, err := url.Parse(server.URL)
+		if err != nil {
+			panic(err)
+		}
+		hosts = append(hosts, parsed.Hostname())
+	}
+	*cfg.ServiceSettings.AllowedUntrustedInternalConnections = strings.Join(hosts, " ")
+	return cfg
+}
+
+func testClient(t *testing.T, cfg *model.Config, servers ...*httptest.Server) *http.Client {
+	t.Helper()
+	client, err := newHTTPClient(newTestHTTPService(cfg, servers...))
+	require.NoError(t, err)
+	t.Cleanup(client.CloseIdleConnections)
+	return client
+}
+
+func discoveryBody(issuer string) string {
+	return fmt.Sprintf(`{"issuer":%q,"authorization_endpoint":"%s/auth","token_endpoint":"%s/token","userinfo_endpoint":"%s/userinfo"}`, issuer, issuer, issuer, issuer)
+}
+
+func TestDiscoveryURL(t *testing.T) {
+	for _, tc := range []struct{ input, target, issuer string }{
+		{"https://idp.example.com", "https://idp.example.com" + wellKnownPath, "https://idp.example.com"},
+		{"https://idp.example.com/", "https://idp.example.com" + wellKnownPath, "https://idp.example.com/"},
+		{"https://idp.example.com/realms/mm", "https://idp.example.com/realms/mm" + wellKnownPath, "https://idp.example.com/realms/mm"},
+		{"https://idp.example.com/realms/mm/", "https://idp.example.com/realms/mm" + wellKnownPath, "https://idp.example.com/realms/mm/"},
+		{"  https://idp.example.com" + wellKnownPath + "  ", "https://idp.example.com" + wellKnownPath, "https://idp.example.com"},
+		{"HTTPS://idp.example.com/realm", "https://idp.example.com/realm" + wellKnownPath, "HTTPS://idp.example.com/realm"},
+		{"HTTPS://idp.example.com/realm" + wellKnownPath, "https://idp.example.com/realm" + wellKnownPath, "HTTPS://idp.example.com/realm"},
+		{"HTTPS://IDP.example.com/ReAlM/%4dM/", "https://IDP.example.com/ReAlM/%4dM" + wellKnownPath, "HTTPS://IDP.example.com/ReAlM/%4dM/"},
+		{"https://idp.example.com/ReAlM/%4DM" + wellKnownPath, "https://idp.example.com/ReAlM/%4DM" + wellKnownPath, "https://idp.example.com/ReAlM/%4DM"},
+	} {
+		t.Run(tc.input, func(t *testing.T) {
+			target, issuer, err := discoveryURL(tc.input)
+			require.NoError(t, err)
+			assert.Equal(t, tc.target, target.String())
+			assert.Equal(t, tc.issuer, issuer)
+		})
+	}
+	for _, input := range []string{
+		"", "http://idp.example.com", "http://localhost:8080/realms/mm", "HTTP://idp.example.com",
+		"file:///etc/passwd", "idp.example.com", "javascript:alert(1)", "https://",
+		"https://user:secret@idp.example.com", "https://idp.example.com#fragment", "https://idp.example.com#",
+		"https://idp.example.com?realm=other", "https://idp.example.com?", "https://idp.example.com/.well-known/other",
+	} {
+		t.Run("reject "+input, func(t *testing.T) {
+			_, _, err := discoveryURL(input)
+			require.Error(t, err)
+		})
+	}
+}
+
+func TestDiscoveryDocumentIsValid(t *testing.T) {
+	valid := func() *discoveryDocument {
+		return &discoveryDocument{Issuer: "https://idp.example.com/realm", AuthorizationEndpoint: "https://idp.example.com/auth", TokenEndpoint: "https://token.example.com/token", UserInfoEndpoint: "https://idp.example.com/userinfo"}
+	}
+	require.NoError(t, valid().IsValid("https://idp.example.com/realm"))
+	doc := valid()
+	doc.Issuer = "HTTPS://idp.example.com/ReAlM/%4dM"
+	require.NoError(t, doc.IsValid(doc.Issuer))
+	for _, normalized := range []string{"https://idp.example.com/ReAlM/%4dM", "HTTPS://idp.example.com/realm/%4dM", "HTTPS://idp.example.com/ReAlM/%4DM", "HTTPS://idp.example.com/ReAlM/MM"} {
+		require.ErrorContains(t, doc.IsValid(normalized), "does not match")
+	}
+	for _, issuer := range []string{"https://other.example.com/realm", "https://idp.example.com/other", "https://idp.example.com/realm/", "https://IDP.example.com/realm"} {
+		t.Run("issuer "+issuer, func(t *testing.T) {
+			require.ErrorContains(t, valid().IsValid(issuer), "does not match")
+		})
+	}
+	for _, field := range []string{"issuer", "authorization_endpoint", "token_endpoint", "userinfo_endpoint"} {
+		t.Run(field, func(t *testing.T) {
+			for _, value := range []string{"", "http://idp.example.com/insecure", "https://user:password@idp.example.com/auth", "https://idp.example.com/auth#fragment"} {
+				doc := valid()
+				switch field {
+				case "issuer":
+					doc.Issuer = value
+				case "authorization_endpoint":
+					doc.AuthorizationEndpoint = value
+				case "token_endpoint":
+					doc.TokenEndpoint = value
+				case "userinfo_endpoint":
+					doc.UserInfoEndpoint = value
+				}
+				require.ErrorContains(t, doc.IsValid("https://idp.example.com/realm"), field)
+			}
+		})
+	}
+}
+
+func TestDiscoveryFetch(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		body func(string) string
+		err  string
+	}{
+		{"valid", discoveryBody, ""},
+		{"missing endpoints", func(issuer string) string { return fmt.Sprintf(`{"issuer":%q}`, issuer) }, "authorization_endpoint"},
+		{"issuer host mixup", func(string) string { return discoveryBody("https://other.example.com") }, "does not match"},
+		{"issuer path mixup", func(issuer string) string { return discoveryBody(issuer + "/other-realm") }, "does not match"},
+		{"HTTP endpoint", func(issuer string) string {
+			return strings.Replace(discoveryBody(issuer), issuer+"/token", "http://insecure.example/token", 1)
+		}, "https"},
+		{"malformed", func(string) string { return `<html>nope</html>` }, "unable to decode"},
+		{"oversized", func(issuer string) string { return discoveryBody(issuer) + strings.Repeat(" ", maxDiscoverySize) }, "exceeds"},
+		{"trailing JSON", func(issuer string) string { return discoveryBody(issuer) + `{}` }, "unable to decode"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			var server *httptest.Server
+			server = httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				assert.Equal(t, "application/json", r.Header.Get("Accept"))
+				_, _ = w.Write([]byte(tc.body(server.URL)))
+			}))
+			defer server.Close()
+			cfg := testConfig(server)
+			doc, err := newDiscoveryCache().get(request.TestContext(t), server.URL, *cfg.ServiceSettings.AllowedUntrustedInternalConnections, testClient(t, cfg, server))
+			if tc.err != "" {
+				require.ErrorContains(t, err, tc.err)
+			} else {
+				require.NoError(t, err)
+				assert.Equal(t, server.URL, doc.Issuer)
+				assert.Equal(t, server.URL+"/token", doc.TokenEndpoint)
+			}
+		})
+	}
+}
+
+func TestDiscoveryTransport(t *testing.T) {
+	for _, tc := range []string{"same origin", "cross origin", "HTTP downgrade", "redirect loop", "invalid certificate", "outbound denied"} {
+		t.Run(tc, func(t *testing.T) {
+			var targetHits atomic.Int64
+			targetHandler := http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+				targetHits.Add(1)
+				w.WriteHeader(http.StatusOK)
+			})
+			target := httptest.NewTLSServer(targetHandler)
+			if tc == "HTTP downgrade" {
+				target.Close()
+				target = httptest.NewServer(targetHandler)
+			}
+			defer target.Close()
+			var server *httptest.Server
+			server = httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				switch tc {
+				case "cross origin", "HTTP downgrade":
+					http.Redirect(w, r, target.URL, http.StatusFound)
+				case "redirect loop":
+					http.Redirect(w, r, server.URL+wellKnownPath, http.StatusFound)
+				case "same origin":
+					if r.URL.Path != "/metadata" {
+						http.Redirect(w, r, server.URL+"/metadata", http.StatusFound)
+						return
+					}
+					_, _ = w.Write([]byte(discoveryBody(server.URL)))
+				default:
+					t.Error("discovery must fail before reaching this handler")
+				}
+			}))
+			defer server.Close()
+			cfg := testConfig(server, target)
+			// Even this global override must not weaken OIDC TLS authentication.
+			*cfg.ServiceSettings.EnableInsecureOutgoingConnections = true
+			trusted := []*httptest.Server{server, target}
+			if tc == "invalid certificate" {
+				trusted = nil
+			}
+			if tc == "outbound denied" {
+				*cfg.ServiceSettings.AllowedUntrustedInternalConnections = ""
+			}
+			_, err := newDiscoveryCache().get(request.TestContext(t), server.URL, *cfg.ServiceSettings.AllowedUntrustedInternalConnections, testClient(t, cfg, trusted...))
+			if tc == "same origin" {
+				require.NoError(t, err)
+			} else {
+				require.Error(t, err)
+			}
+			require.Zero(t, targetHits.Load(), "redirect targets must never receive a request")
+		})
+	}
+}
+
+func TestDiscoveryCache(t *testing.T) {
+	for _, failure := range []bool{false, true} {
+		t.Run(fmt.Sprintf("failure=%t", failure), func(t *testing.T) {
+			var hits atomic.Int64
+			var server *httptest.Server
+			server = httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+				hit := hits.Add(1)
+				time.Sleep(50 * time.Millisecond)
+				if failure && hit == 1 {
+					w.WriteHeader(http.StatusServiceUnavailable)
+					return
+				}
+				_, _ = w.Write([]byte(discoveryBody(server.URL)))
+			}))
+			defer server.Close()
+			cfg := testConfig(server)
+			client := testClient(t, cfg, server)
+			cache := newDiscoveryCache()
+			now := time.Now()
+			cache.now = func() time.Time { return now }
+			rctx := request.TestContext(t)
+			const callers = 25
+			errs := make([]error, callers)
+			var wg sync.WaitGroup
+			start := make(chan struct{})
+			for i := range callers {
+				wg.Add(1)
+				go func() {
+					defer wg.Done()
+					<-start
+					_, errs[i] = cache.get(rctx, server.URL, "127.0.0.1", client)
+				}()
+			}
+			close(start)
+			wg.Wait()
+			for _, err := range errs {
+				if failure {
+					require.ErrorContains(t, err, "503")
+				} else {
+					require.NoError(t, err)
+				}
+			}
+			require.EqualValues(t, 1, hits.Load(), "both success and failure collapse concurrent requests")
+			_, _ = cache.get(rctx, server.URL, "127.0.0.1", client)
+			require.EqualValues(t, 1, hits.Load())
+			if failure {
+				now = now.Add(discoveryFailureTTL + time.Second)
+			} else {
+				now = now.Add(discoveryTTL + time.Second)
+			}
+			_, err := cache.get(rctx, server.URL, "127.0.0.1", client)
+			require.NoError(t, err)
+			require.EqualValues(t, 2, hits.Load())
+		})
+	}
+}
+
+func TestMaintainedMostDiscoveryCachePolicyIsolation(t *testing.T) {
+	var hits atomic.Int64
+	var server *httptest.Server
+	server = httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		hits.Add(1)
+		_, _ = w.Write([]byte(discoveryBody(server.URL)))
+	}))
+	defer server.Close()
+	allowed, denied := testConfig(server), testConfig()
+	configureSSO(allowed, model.ServiceOpenid, server.URL)
+	configureSSO(denied, model.ServiceOpenid, server.URL)
+	p := New()
+	rctx := request.TestContext(t)
+	// Prime a trusted document, then use the production per-request service
+	// factory (not an injected service tied to one of these configurations).
+	_, err := p.discovery.get(rctx, server.URL, "127.0.0.1", testClient(t, allowed, server))
+	require.NoError(t, err)
+	var wg sync.WaitGroup
+	for i := range 30 {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			if i%2 == 0 {
+				_, err := p.GetSSOSettings(rctx, allowed, model.ServiceOpenid)
+				assert.NoError(t, err)
+			} else {
+				_, err := p.GetSSOSettings(rctx, denied, model.ServiceOpenid)
+				assert.ErrorContains(t, err, httpservice.ErrAddressForbidden.Error())
+			}
+		}()
+	}
+	wg.Wait()
+	require.EqualValues(t, 1, hits.Load())
+}
