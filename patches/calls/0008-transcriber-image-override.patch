+func TestMaintainedMostTranscriberImageRunners(t *testing.T) {
+	const registry = "ghcr.io/example/maintainedmost"
+	for _, tc := range []struct {
+		name     string
+		registry string
+		image    string
+		enabled  bool
+	}{
+		{name: "upstream defaults", enabled: true},
+		{name: "registry defaults", registry: registry, enabled: true},
+		{name: "transcriber tag override only", image: "mattermost/calls-transcriber:v1.5.0", enabled: true},
+		{name: "release tag in shared registry", registry: registry, image: registry + "/calls-transcriber:v1.5.0", enabled: true},
+		{name: "development tag in shared registry", registry: registry, image: registry + "/calls-transcriber:v1.0.0-dev0", enabled: true},
+		{name: "disabled until later", registry: registry, image: registry + "/calls-transcriber:v1.5.0"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			p, inits, jobs := maintainedmostJobService(t, tc.registry, tc.enabled)
+			t.Setenv("MM_CALLS_TRANSCRIBER_IMAGE", tc.image)
+			require.NoError(t, p.initJobService())
+			registry := tc.registry
+			if registry == "" {
+				registry = job.ImageRegistryDefault
+			}
+			recorderRunner := fmt.Sprintf("%s/%s:%s", registry, job.RecordingJobPrefix, manifest.Props["calls_recorder_version"])
+			transcriberRunner := fmt.Sprintf("%s/%s:%s", registry, job.TranscribingJobPrefix, manifest.Props["calls_transcriber_version"])
+			if tc.image != "" {
+				transcriberRunner = tc.image
+			}
+			wantRunners := []string{recorderRunner}
+			if tc.enabled {
+				wantRunners = append(wantRunners, transcriberRunner)
+			}
+			require.Equal(t, wantRunners, (<-inits).Runners)
+
+			// The runner must also be ready if transcriptions are enabled later.
+			cfg := p.getConfiguration()
+			cfg.EnableTranscriptions = model.NewPointer(true)
+			require.NoError(t, p.setConfiguration(cfg))
+			for _, jt := range []job.Type{job.TypeRecording, job.TypeTranscribing} {
+				id, err := p.getJobService().RunJob(jt, model.NewId(), model.NewId(), model.NewId(), model.NewId())
+				require.NoError(t, err)
+				require.Equal(t, "offloader-job-id", id)
+				sent := <-jobs
+				require.Equal(t, jt, sent.Type)
+				require.NotContains(t, sent.InputData, "image")
+				if jt == job.TypeRecording {
+					require.Equal(t, recorderRunner, sent.Runner)
+				} else {
+					require.Equal(t, transcriberRunner, sent.Runner)
+					require.Equal(t, "whisper.cpp", sent.InputData["transcribe_api"], "choosing an image must not opt into remote transcription")
+				}
+			}
+		})
+	}
+}
