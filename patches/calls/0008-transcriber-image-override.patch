+func TestMaintainedMostTranscriberImageRejections(t *testing.T) {
+	const registry = "ghcr.io/example/maintainedmost"
+	for _, tc := range []struct {
+		name  string
+		image string
+	}{
+		{name: "wrong image name", image: registry + "/transcriber:v1.5.0"},
+		{name: "legacy image layout", image: registry + ":v1.5.0-transcriber"},
+		{name: "non-semver tag", image: registry + "/calls-transcriber:latest"},
+		{name: "unsupported tag suffix", image: registry + "/calls-transcriber:v1.5.0-transcriber"},
+		{name: "wrong registry", image: "ghcr.io/other/maintainedmost/calls-transcriber:v1.5.0"},
+		{name: "digest", image: registry + "/calls-transcriber@sha256:" + strings.Repeat("a", 64)},
+		{name: "below minimum version", image: registry + "/calls-transcriber:v0.0.0"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			for _, enabled := range []bool{true, false} {
+				t.Run(fmt.Sprintf("enabled_at_init=%t", enabled), func(t *testing.T) {
+					p, inits, jobs := maintainedmostJobService(t, registry, enabled)
+					t.Setenv("MM_CALLS_TRANSCRIBER_IMAGE", tc.image)
+					if enabled {
+						require.ErrorContains(t, p.initJobService(), "request failed: invalid job service config:")
+						require.Nil(t, p.getJobService())
+						require.Empty(t, inits, "invalid runners must not be accepted for prefetch")
+						require.Empty(t, jobs)
+						return
+					}
+
+					// A disabled transcriber is not prefetched. Its runner must
+					// still be rejected by /jobs when transcriptions are enabled.
+					require.NoError(t, p.initJobService())
+					recorderRunner := fmt.Sprintf("%s/%s:%s", registry, job.RecordingJobPrefix, manifest.Props["calls_recorder_version"])
+					require.Equal(t, []string{recorderRunner}, (<-inits).Runners)
+					cfg := p.getConfiguration()
+					cfg.EnableTranscriptions = model.NewPointer(true)
+					require.NoError(t, p.setConfiguration(cfg))
+					id, err := p.getJobService().RunJob(job.TypeTranscribing, model.NewId(), model.NewId(), model.NewId(), model.NewId())
+					require.ErrorContains(t, err, "request failed: invalid Runner value:")
+					require.Empty(t, id)
+					require.Empty(t, jobs, "invalid runner must not create a job")
+
+					id, err = p.getJobService().RunJob(job.TypeRecording, model.NewId(), model.NewId(), model.NewId(), model.NewId())
+					require.NoError(t, err)
+					require.Equal(t, "offloader-job-id", id)
+					recorded := <-jobs
+					require.Equal(t, recorderRunner, recorded.Runner)
+					require.NotContains(t, recorded.InputData, "image")
+				})
+			}
+		})
+	}
