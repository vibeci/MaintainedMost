+func TestMaintainedMostTranscriberLateJobEnvironment(t *testing.T) {
+	const registry = "ghcr.io/example/maintainedmost"
+	const image = registry + "/calls-transcriber:v1.5.0"
+	p, inits, jobs := maintainedmostJobService(t, registry, true)
+	t.Setenv("MM_CALLS_TRANSCRIBER_IMAGE", image)
+	options := map[string]string{
+		"TRANSCRIBE_API":             "openai/api",
+		"OPENAI_API_BASE_URL":        "https://speech.example.com/v1",
+		"OPENAI_API_KEY":             "test-key=with-padding",
+		"OPENAI_API_MODEL":           "whisper-large-v3",
+		"OPENAI_API_TIMEOUT_SECONDS": "17",
+	}
+	for key, value := range options {
+		t.Setenv("MM_CALLS_TRANSCRIBER_"+key, value)
+	}
+	require.NoError(t, p.initJobService())
+	<-inits
+	callID, postID, jobID, authToken := model.NewId(), model.NewId(), model.NewId(), model.NewId()
+	_, err := p.getJobService().RunJob(job.TypeTranscribing, callID, postID, jobID, authToken)
+	require.NoError(t, err)
+	sent := <-jobs
+	require.Equal(t, image, sent.Runner)
+	require.Equal(t, int64(*p.getConfiguration().MaxRecordingDuration*120), sent.MaxDurationSec)
+	require.Equal(t, "https://mattermost.example.com", sent.InputData["site_url"])
+	require.Equal(t, callID, sent.InputData["call_id"])
+	require.Equal(t, postID, sent.InputData["post_id"])
+	require.Equal(t, jobID, sent.InputData["transcription_id"])
+	require.Equal(t, authToken, sent.InputData["auth_token"])
+	require.NotContains(t, sent.InputData, "image")
+	for key, value := range options {
+		require.Equal(t, value, sent.InputData[strings.ToLower(key)])
+		require.Contains(t, sent.InputData.ToEnv(), key+"="+value)
+	}
+	require.Contains(t, sent.InputData.ToEnv(), "TRANSCRIBE_API_OPTIONS=null")
+	require.Equal(t, transcriber.TranscribeAPI(transcriber.TranscribeAPIWhisperCPP), p.getConfiguration().TranscribeAPI)
+	_, err = p.getJobService().RunJob(job.TypeRecording, callID, postID, jobID, authToken)
+	require.NoError(t, err)
+	recorded := <-jobs
+	require.Equal(t, fmt.Sprintf("%s/%s:%s", registry, job.RecordingJobPrefix, manifest.Props["calls_recorder_version"]), recorded.Runner)
+	for key := range options {
+		require.NotContains(t, recorded.InputData, strings.ToLower(key))
+	}
+	require.NotContains(t, recorded.InputData, "image")
+
+	// Calls still validates against the upstream module before applying the
+	// job-only overrides. Setting the plugin field itself is not supported.
+	cfg := p.getConfiguration()
+	cfg.TranscribeAPI = "openai/api"
+	require.EqualError(t, cfg.IsValid(), "TranscribeAPI is not valid")
+}
