+// Exercise initialization and dispatch through the real offloader HTTP client.
+// Enforce the stock offloader validators without running Docker containers.
+func maintainedmostJobService(t *testing.T, registry string, transcriptions bool) (*Plugin, <-chan job.ServiceConfig, <-chan job.Config) {
+	t.Helper()
+	for _, env := range os.Environ() {
+		key, _, _ := strings.Cut(env, "=")
+		if strings.HasPrefix(key, "MM_CALLS_TRANSCRIBER_") || strings.HasPrefix(key, "MM_CALLS_RECORDER_") {
+			t.Setenv(key, "")
+			require.NoError(t, os.Unsetenv(key))
+		}
+	}
+	oldRecorder, oldTranscriber := recorderJobRunner, transcriberJobRunner
+	t.Cleanup(func() { recorderJobRunner, transcriberJobRunner = oldRecorder, oldTranscriber })
+	t.Setenv("DEV_MODE", "")
+	t.Setenv("TEST_MODE", "")
+	t.Setenv("MM_CALLS_JOB_SERVICE_IMAGE_REGISTRY", registry)
+	if registry == "" {
+		registry = job.ImageRegistryDefault
+	}
+
+	inits := make(chan job.ServiceConfig, 1)
+	jobs := make(chan job.Config, 2)
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		if r.Method == http.MethodGet && r.URL.Path == "/version" {
+			fmt.Fprint(w, `{"buildVersion":"v0.9.4"}`)
+			return
+		}
+		clientID, authKey, ok := r.BasicAuth()
+		if !ok || clientID != "test-client" || authKey != "test-auth-key" {
+			t.Error("offloader request is missing authentication")
+			w.WriteHeader(http.StatusUnauthorized)
+			return
+		}
+		switch {
+		case r.Method == http.MethodPost && r.URL.Path == "/jobs/init":
+			var cfg job.ServiceConfig
+			if err := json.NewDecoder(r.Body).Decode(&cfg); err != nil {
+				t.Error(err)
+				w.WriteHeader(http.StatusBadRequest)
+				return
+			}
+			if err := cfg.IsValid(registry); err != nil {
+				w.WriteHeader(http.StatusBadRequest)
+				if err := json.NewEncoder(w).Encode(map[string]string{"error": "invalid job service config: " + err.Error()}); err != nil {
+					t.Error(err)
+				}
+				return
+			}
+			inits <- cfg
+		case r.Method == http.MethodPost && r.URL.Path == "/jobs":
+			var cfg job.Config
+			if err := json.NewDecoder(r.Body).Decode(&cfg); err != nil {
+				t.Error(err)
+				w.WriteHeader(http.StatusBadRequest)
+				return
+			}
+			if err := cfg.IsValid(registry); err != nil {
+				w.WriteHeader(http.StatusBadRequest)
+				if err := json.NewEncoder(w).Encode(map[string]string{"error": err.Error()}); err != nil {
+					t.Error(err)
+				}
+				return
+			}
+			jobs <- cfg
+			fmt.Fprint(w, `{"id":"offloader-job-id"}`)
+		default:
+			t.Errorf("unexpected offloader request: %s %s", r.Method, r.URL.Path)
+			w.WriteHeader(http.StatusNotFound)
+		}
+	}))
+	t.Cleanup(srv.Close)
+	t.Setenv("MM_CALLS_JOB_SERVICE_CLIENT_ID", "test-client")
+	t.Setenv("MM_CALLS_JOB_SERVICE_AUTH_KEY", "test-auth-key")
+	t.Setenv("MM_CALLS_JOB_SERVICE_URL", srv.URL)
+
+	mockAPI := &pluginMocks.MockAPI{}
+	mockMetrics := &serverMocks.MockMetrics{}
+	for _, key := range []string{"mutex_job_service_registration", "mutex_job_service_runner_update"} {
+		mockAPI.On("KVSetWithOptions", key, []byte{1}, mock.Anything).Return(true, nil).Once()
+		mockAPI.On("KVDelete", key).Return(nil).Once()
+		mockMetrics.On("ObserveClusterMutexGrabTime", key, mock.Anything).Once()
+		mockMetrics.On("ObserveClusterMutexLockedTime", key, mock.Anything).Once()
+	}
+	mockAPI.On("LogDebug", mock.Anything, mock.Anything, mock.Anything).Maybe()
+	mockAPI.On("LogDebug", mock.Anything, mock.Anything, mock.Anything,
+		mock.Anything, mock.Anything, mock.Anything, mock.Anything).Maybe()
+	mockAPI.On("GetConfig").Return(&model.Config{
+		ServiceSettings: model.ServiceSettings{SiteURL: model.NewPointer("https://mattermost.example.com")},
+	}).Maybe()
+	t.Cleanup(func() {
+		mockAPI.AssertExpectations(t)
+		mockMetrics.AssertExpectations(t)
+	})
+	cfg := &configuration{}
+	cfg.SetDefaults()
+	cfg.EnableRecordings = model.NewPointer(true)
+	cfg.EnableTranscriptions = model.NewPointer(transcriptions)
+	cfg.JobServiceURL = srv.URL
+	p := &Plugin{
+		MattermostPlugin: plugin.MattermostPlugin{API: mockAPI},
+		configuration:    cfg,
+		metrics:          mockMetrics,
+	}
+	t.Cleanup(func() {
+		if svc := p.getJobService(); svc != nil {
+			require.NoError(t, svc.Close())
+		}
+	})
+	return p, inits, jobs
+}
