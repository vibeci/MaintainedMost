+// Copyright (c) 2026-present Mattermore contributors. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+package main
+
+import (
+	"encoding/json"
+	"os"
+	"testing"
+
+	pluginMocks "github.com/mattermost/mattermost-plugin-calls/server/mocks/github.com/mattermost/mattermost/server/public/plugin"
+	"github.com/mattermost/mattermost/server/public/model"
+	"github.com/mattermost/mattermost/server/public/plugin"
+	"github.com/stretchr/testify/require"
+)
+
+func TestMaintainedMostRecordingDefaults(t *testing.T) {
+	for _, tc := range []struct {
+		name               string
+		url                string
+		stored             map[string]any
+		env                map[string]string
+		wantRecordings     bool
+		wantTranscriptions bool
+	}{
+		{name: "no job URL"},
+		{name: "blank job URL", url: "  "},
+		{name: "stored job URL", url: "http://offloader:4545", wantRecordings: true, wantTranscriptions: true},
+		{
+			name:           "environment job URL",
+			env:            map[string]string{"MM_CALLS_JOB_SERVICE_URL": "http://offloader:4545"},
+			wantRecordings: true, wantTranscriptions: true,
+		},
+		{
+			name: "stored false wins over defaults", url: "http://offloader:4545",
+			stored: map[string]any{"enablerecordings": false, "enabletranscriptions": false},
+		},
+		{
+			name:           "stored true is retained without a job URL",
+			stored:         map[string]any{"enablerecordings": true, "enabletranscriptions": true},
+			wantRecordings: true, wantTranscriptions: true,
+		},
+		{
+			name: "environment false without stored choices", url: "http://offloader:4545",
+			env: map[string]string{"MM_CALLS_ENABLE_RECORDINGS": "false", "MM_CALLS_ENABLE_TRANSCRIPTIONS": "false"},
+		},
+		{
+			name: "environment false overrides stored true", url: "http://offloader:4545",
+			stored: map[string]any{"enablerecordings": true, "enabletranscriptions": true},
+			env:    map[string]string{"MM_CALLS_ENABLE_RECORDINGS": "false", "MM_CALLS_ENABLE_TRANSCRIPTIONS": "false"},
+		},
+		{
+			name: "environment false with stored false", url: "http://offloader:4545",
+			stored: map[string]any{"enablerecordings": false, "enabletranscriptions": false},
+			env:    map[string]string{"MM_CALLS_ENABLE_RECORDINGS": "false", "MM_CALLS_ENABLE_TRANSCRIPTIONS": "false"},
+		},
+		{
+			name: "environment true overrides stored false", url: "http://offloader:4545",
+			stored:         map[string]any{"enablerecordings": false, "enabletranscriptions": false},
+			env:            map[string]string{"MM_CALLS_ENABLE_RECORDINGS": "true", "MM_CALLS_ENABLE_TRANSCRIPTIONS": "true"},
+			wantRecordings: true, wantTranscriptions: true,
+		},
+		{
+			name: "transcription opt out is independent", url: "http://offloader:4545",
+			env:            map[string]string{"MM_CALLS_ENABLE_TRANSCRIPTIONS": "false"},
+			wantRecordings: true,
+		},
+		{
+			name: "recording opt out disables effective transcription", url: "http://offloader:4545",
+			env:                map[string]string{"MM_CALLS_ENABLE_RECORDINGS": "false"},
+			wantTranscriptions: true,
+		},
+		{
+			name: "empty environment job URL clears stored URL", url: "http://offloader:4545",
+			env: map[string]string{"MM_CALLS_JOB_SERVICE_URL": ""},
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			for _, key := range []string{"MM_CALLS_JOB_SERVICE_URL", "MM_CALLS_ENABLE_RECORDINGS", "MM_CALLS_ENABLE_TRANSCRIPTIONS"} {
+				t.Setenv(key, "")
+				require.NoError(t, os.Unsetenv(key))
+			}
+			for key, value := range tc.env {
+				t.Setenv(key, value)
+			}
+
+			api := pluginMocks.NewMockAPI(t)
+			api.On("GetLicense").Return((*model.License)(nil))
+			api.On("GetConfig").Return(&model.Config{
+				PluginSettings: model.PluginSettings{Plugins: map[string]map[string]any{manifest.Id: tc.stored}},
+			}).Maybe()
+			p := &Plugin{MattermostPlugin: plugin.MattermostPlugin{API: api}}
+			cfg := &configuration{JobServiceURL: tc.url}
+			data, err := json.Marshal(tc.stored)
+			require.NoError(t, err)
+			require.NoError(t, json.Unmarshal(data, cfg))
+			cfg.SetDefaults()
+			p.setOverrides(cfg)
+
+			require.Equal(t, tc.wantRecordings, *cfg.EnableRecordings)
+			require.Equal(t, tc.wantTranscriptions, *cfg.EnableTranscriptions)
+			require.Equal(t, tc.wantRecordings && tc.wantTranscriptions, cfg.transcriptionsEnabled())
+			if value, ok := tc.env["MM_CALLS_ENABLE_RECORDINGS"]; ok {
+				require.Equal(t, value, p.configEnvOverrides["EnableRecordings"])
+			}
+			if value, ok := tc.env["MM_CALLS_ENABLE_TRANSCRIPTIONS"]; ok {
+				require.Equal(t, value, p.configEnvOverrides["EnableTranscriptions"])
+			}
+		})
+	}
+}
