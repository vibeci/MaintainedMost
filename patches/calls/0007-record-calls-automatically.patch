+// autoStartRecording runs outside the join path, but only for the original
+// call and host. An unavailable job service is reported, not retried.
+func (p *Plugin) autoStartRecording(channelID, callID, userID string) {
+	state, err := p.lockCallReturnState(channelID)
+	if err != nil {
+		p.LogError("failed to lock call for automatic recording", "err", err.Error(), "callID", callID)
+		return
+	}
+	defer p.unlockCall(channelID)
+
+	// The call or configuration may have changed while the goroutine waited.
+	if state == nil || state.Call.ID != callID || state.Call.EndAt != 0 || !p.getConfiguration().recordCallsByDefault() {
+		return
+	}
+	if state.Call.GetHostID() != userID || !state.isUserIDInCall(userID) ||
+		!p.API.HasPermissionToChannel(userID, channelID, model.PermissionReadChannel) {
+		return
+	}
+	if state.Recording != nil && state.Recording.EndAt == 0 {
+		return
+	}
+	if p.getJobService() == nil {
+		p.LogWarn("skipping automatic recording: job service is not initialized", "callID", callID, "channelID", channelID)
+		return
+	}
+
+	if _, _, err := p.startRecordingJob(state, channelID, userID); err != nil {
+		p.LogError("failed to start automatic recording", "err", err.Error(), "callID", callID)
+	}
+}
+
