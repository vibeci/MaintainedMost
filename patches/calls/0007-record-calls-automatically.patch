+	"github.com/stretchr/testify/require"
+)
+
+func TestMaintainedMostRecordCallsByDefault(t *testing.T) {
+	cfg := &configuration{}
+	cfg.SetDefaults()
+	require.False(t, *cfg.RecordCallsByDefault)
+	cfg.EnableRecordings = model.NewPointer(true)
+	require.False(t, cfg.recordCallsByDefault())
+	cfg.RecordCallsByDefault = model.NewPointer(true)
+	require.True(t, cfg.recordCallsByDefault())
+	clone := cfg.Clone()
+	*clone.RecordCallsByDefault = false
+	require.True(t, *cfg.RecordCallsByDefault)
+	cfg.EnableRecordings = model.NewPointer(false)
+	require.False(t, cfg.recordCallsByDefault())
+
+	api := pluginMocks.NewMockAPI(t)
+	api.On("GetLicense").Return((*model.License)(nil))
+	p := &Plugin{MattermostPlugin: plugin.MattermostPlugin{API: api}, licenseChecker: license.NewChecker(api)}
+	require.Equal(t, cfg.RecordCallsByDefault, p.getClientConfig(cfg).RecordCallsByDefault)
+}
+
+func TestMaintainedMostRecordingTimeoutStopsOnShutdown(t *testing.T) {
+	p := &Plugin{stopCh: make(chan struct{})}
+	done := make(chan struct{})
+	go func() {
+		p.recJobTimeoutChecker("channel", "job")
+		close(done)
+	}()
+	close(p.stopCh)
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("recording timeout checker did not stop on shutdown")
+	}
+}
+
+func TestMaintainedMostAutoStartRecording(t *testing.T) {
+	store, tearDown := NewTestStore(t)
+	t.Cleanup(tearDown)
+
+	for _, tc := range []struct {
+		name        string
+		unready     bool
+		disabled    bool
+		recordsOff  bool
+		missing     bool
+		ended       bool
+		newCall     bool
+		notHost     bool
+		hostLeft    bool
+		forbidden   bool
+		existing    bool
+		concurrent  bool
+		reject      bool
+		wantRequest bool
+	}{
+		{name: "ready service", wantRequest: true},
+		{name: "unready service", unready: true},
+		{name: "automatic recording disabled", disabled: true},
+		{name: "recordings disabled", recordsOff: true},
+		{name: "call disappeared", missing: true},
+		{name: "call ended", ended: true},
+		{name: "channel now has a different call", newCall: true},
+		{name: "host changed", notHost: true},
+		{name: "host left", hostLeft: true},
+		{name: "channel permission revoked", forbidden: true},
+		{name: "recording already pending", existing: true},
+		{name: "concurrent automatic starts", concurrent: true, wantRequest: true},
+		{name: "offloader request fails", reject: true, wantRequest: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Cleanup(func() { ResetTestStore(t, store) })
+			userID, participantID, botID := model.NewId(), model.NewId(), model.NewId()
+			channelID := model.NewId()
+			call := &public.Call{
+				ID: model.NewId(), ChannelID: channelID, OwnerID: userID, PostID: model.NewId(),
+				CreateAt: time.Now().UnixMilli(), StartAt: time.Now().UnixMilli(),
+				Props: public.CallProps{Hosts: []string{userID}},
+			}
+			if tc.ended {
+				call.EndAt = call.StartAt + 1
+			}
+			if tc.notHost {
+				call.Props.Hosts = []string{participantID}
+			}
+			if !tc.missing {
+				require.NoError(t, store.CreateCall(call))
+				for _, id := range []string{userID, participantID} {
+					if id == userID && tc.hostLeft {
+						continue
+					}
+					require.NoError(t, store.CreateCallSession(&public.CallSession{
+						ID: model.NewId(), CallID: call.ID, UserID: id, JoinAt: call.StartAt,
+					}))
+				}
+				createPost(t, store, call.PostID, userID, channelID)
+			}
+			if tc.existing {
+				require.NoError(t, store.CreateCallJob(&public.CallJob{
+					ID: model.NewId(), CallID: call.ID, CreatorID: userID,
+					Type: public.JobTypeRecording, InitAt: call.StartAt,
+				}))
+			}
+
+			var requests atomic.Int32
+			inputs := make(chan job.Config, 2)
+			srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				requests.Add(1)
+				if r.Method != http.MethodPost || r.URL.Path != "/jobs" {
+					http.Error(w, "unexpected request", http.StatusBadRequest)
+					return
+				}
+				var input job.Config
+				if err := json.NewDecoder(r.Body).Decode(&input); err != nil {
+					http.Error(w, err.Error(), http.StatusBadRequest)
+					return
+				}
+				inputs <- input
+				if tc.reject {
+					w.WriteHeader(http.StatusServiceUnavailable)
+					_ = json.NewEncoder(w).Encode(map[string]string{"error": "offloader unavailable"})
+					return
+				}
+				_ = json.NewEncoder(w).Encode(job.Job{ID: "recording-job"})
+			}))
+			t.Cleanup(srv.Close)
+
+			api := pluginMocks.NewMockAPI(t)
+			metrics := serverMocks.NewMockMetrics(t)
+			cfg := &configuration{}
+			cfg.SetDefaults()
+			cfg.EnableRecordings = model.NewPointer(!tc.recordsOff)
+			if !tc.disabled {
+				cfg.RecordCallsByDefault = model.NewPointer(true)
+			}
+			p := &Plugin{
+				MattermostPlugin: plugin.MattermostPlugin{API: api},
+				configuration:    cfg, store: store, metrics: metrics,
+				botSession:        &model.Session{UserId: botID, Token: model.NewId()},
+				callsClusterLocks: map[string]*cluster.Mutex{}, stopCh: make(chan struct{}),
+			}
+			t.Cleanup(func() { close(p.stopCh) })
+			if !tc.unready {
+				client, err := offloader.NewClient(offloader.ClientConfig{URL: srv.URL})
+				require.NoError(t, err)
+				p.jobService = &jobService{ctx: p, client: client}
+				t.Cleanup(func() { require.NoError(t, client.Close()) })
+			}
+
+			api.On("KVSetWithOptions", "mutex_call_"+channelID, mock.Anything, mock.Anything).Return(true, nil)
+			api.On("KVDelete", "mutex_call_"+channelID).Return(nil)
+			api.On("LogDebug", "creating cluster mutex for call", "origin", mock.Anything, "channelID", channelID)
+			api.On("HasPermissionToChannel", userID, channelID, model.PermissionReadChannel).Return(!tc.forbidden).Maybe()
+			metrics.On("ObserveClusterMutexGrabTime", "mutex_call", mock.Anything)
+			metrics.On("ObserveClusterMutexLockedTime", "mutex_call", mock.Anything)
+			metrics.On("ObserveAppHandlersTime", "getCallState", mock.Anything)
+			if tc.unready {
+				api.On("LogWarn", "skipping automatic recording: job service is not initialized",
+					"origin", mock.Anything, "callID", call.ID, "channelID", channelID).Once()
+			}
+			if tc.wantRequest {
+				api.On("GetConfig").Return(&model.Config{ServiceSettings: model.ServiceSettings{SiteURL: model.NewPointer("https://mattermost.example")}})
+				api.On("PublishWebSocketEvent", wsEventCallJobState, mock.Anything, mock.Anything)
+				metrics.On("IncWebSocketEvent", "out", wsEventCallJobState)
+				if tc.reject {
+					api.On("LogError", "failed to start automatic recording", "origin", mock.Anything, "err", mock.Anything, "callID", call.ID).Once()
+				} else {
+					api.On("LogDebug", "recording job started successfully", "origin", mock.Anything, "jobID", "recording-job", "callID", channelID).Once()
+					api.On("UpdatePost", mock.Anything).Return(&model.Post{Id: call.PostID}, nil).Once()
+				}
+			}
+
+			expectedCallID := call.ID
+			if tc.newCall {
+				expectedCallID = model.NewId()
+			}
+			if tc.concurrent {
+				var wg sync.WaitGroup
+				for range 2 {
+					wg.Go(func() { p.autoStartRecording(channelID, expectedCallID, userID) })
+				}
+				wg.Wait()
+			} else {
+				p.autoStartRecording(channelID, expectedCallID, userID)
+			}
+
+			jobs, err := store.GetActiveCallJobs(call.ID, db.GetCallJobOpts{FromWriter: true})
+			require.NoError(t, err)
+			if !tc.wantRequest {
+				require.Zero(t, requests.Load())
+				api.AssertNotCalled(t, "PublishWebSocketEvent", mock.Anything, mock.Anything, mock.Anything)
+				if tc.existing {
+					require.Len(t, jobs, 1)
+				} else {
+					require.Empty(t, jobs)
+				}
+				return
+			}
+
+			require.EqualValues(t, 1, requests.Load())
+			input := <-inputs
+			require.Equal(t, job.TypeRecording, input.Type)
+			require.Equal(t, channelID, input.InputData["call_id"])
+			require.Equal(t, call.PostID, input.InputData["post_id"])
+			recording, err := store.GetCallJob(input.InputData["recording_id"].(string), db.GetCallJobOpts{IncludeEnded: true})
+			require.NoError(t, err)
+			require.Equal(t, userID, recording.CreatorID)
+			require.Equal(t, call.ID, recording.CallID)
+			if tc.reject {
+				require.NotZero(t, recording.EndAt)
+				require.Contains(t, recording.Props.Err, "offloader unavailable")
+				require.Empty(t, jobs)
+			} else {
+				require.Len(t, jobs, 1)
+				require.Equal(t, "recording-job", recording.Props.JobID)
+			}
+			for _, id := range []string{userID, participantID} {
+				api.AssertCalled(t, "PublishWebSocketEvent", wsEventCallJobState, mock.Anything,
+					mock.MatchedBy(func(b *model.WebsocketBroadcast) bool {
+						return b.UserId == id && b.ChannelId == channelID && b.ReliableClusterSend
+					}))
+			}
+		})
+	}
+}
