+package openai
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/mattermost/calls-transcriber/cmd/transcriber/transcribe"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestMaintainedMostTranscribeRetriesInterruptedBody(t *testing.T) {
+	for _, body := range []string{`{"text":"`, `{"text":"incomplete transport"}`, ""} {
+		t.Run(body, func(t *testing.T) {
+			var requests atomic.Int32
+			srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if requests.Add(1) == 1 {
+					// The server closes before delivering the advertised body length.
+					w.Header().Set("Content-Length", "1000")
+					fmt.Fprint(w, body)
+					return
+				}
+				if r.Header.Get("Authorization") != "Bearer test-api-key" {
+					t.Error("retry lost authorization")
+				}
+				if err := r.ParseMultipartForm(1 << 20); err != nil {
+					t.Errorf("retry lost multipart body: %v", err)
+					return
+				}
+				defer r.MultipartForm.RemoveAll()
+				if r.FormValue("model") != ModelDefault || r.FormValue("response_format") != "verbose_json" {
+					t.Error("retry lost transcription options")
+				}
+				fmt.Fprint(w, `{"language":"english","segments":[{"start":0,"end":1,"text":"recovered"}]}`)
+			}))
+			defer srv.Close()
+
+			c := newTestClient(t, srv.URL+"/v1")
+			segments, lang, err := c.Transcribe(make([]float32, audioSampleRate))
+			require.NoError(t, err)
+			require.Equal(t, int32(2), requests.Load())
+			require.Equal(t, "en", lang)
+			require.Equal(t, []transcribe.Segment{{Text: "recovered", StartTS: 0, EndTS: 1000}}, segments)
+		})
+	}
+}
+
+func TestMaintainedMostTranscribeInterruptedBodyRetryLimit(t *testing.T) {
+	var requests atomic.Int32
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		requests.Add(1)
+		w.Header().Set("Content-Length", "1000")
+		fmt.Fprint(w, `{"text":"test-api-key private-response`)
+	}))
+	defer srv.Close()
+
+	c := newTestClient(t, srv.URL+"/v1")
+	_, _, err := c.Transcribe(make([]float32, audioSampleRate))
+	require.ErrorIs(t, err, io.ErrUnexpectedEOF)
+	require.NotContains(t, err.Error(), "test-api-key")
+	require.NotContains(t, err.Error(), "private-response")
+	require.Equal(t, int32(maxAttempts), requests.Load())
+}
+
+func TestMaintainedMostTranscribeBodyTimeout(t *testing.T) {
+	for _, recover := range []bool{true, false} {
+		t.Run(fmt.Sprintf("recover=%t", recover), func(t *testing.T) {
+			var requests atomic.Int32
+			stopCh := make(chan struct{})
+			srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if requests.Add(1) > 1 && recover {
+					fmt.Fprint(w, `{"text":"recovered"}`)
+					return
+				}
+				fmt.Fprint(w, `{"text":"test-api-key private-response`)
+				w.(http.Flusher).Flush()
+				select {
+				case <-r.Context().Done():
+				case <-stopCh:
+				}
+			}))
+			defer srv.Close()
+			defer close(stopCh)
+
+			c := newTestClient(t, srv.URL+"/v1")
+			c.cfg.Timeout = 100 * time.Millisecond
+			segments, _, err := c.Transcribe(make([]float32, audioSampleRate))
+			if recover {
+				require.NoError(t, err)
+				require.Equal(t, int32(2), requests.Load())
+				require.Equal(t, []transcribe.Segment{{Text: "recovered", EndTS: 1000}}, segments)
+			} else {
+				require.ErrorIs(t, err, context.DeadlineExceeded)
+				require.NotContains(t, err.Error(), "test-api-key")
+				require.NotContains(t, err.Error(), "private-response")
+				require.Equal(t, int32(maxAttempts), requests.Load())
+			}
+		})
+	}
+}
+
+func TestMaintainedMostTranscribeBodyCancellation(t *testing.T) {
+	var requests atomic.Int32
+	started := make(chan struct{}, maxAttempts)
+	stopCh := make(chan struct{})
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		requests.Add(1)
+		fmt.Fprint(w, `{"text":"test-api-key private-response`)
+		w.(http.Flusher).Flush()
+		started <- struct{}{}
+		select {
+		case <-r.Context().Done():
+		case <-stopCh:
+		}
+	}))
+	defer srv.Close()
+	defer close(stopCh)
+
+	c := newTestClient(t, srv.URL+"/v1")
+	c.cfg.Timeout = 10 * time.Second
+	done := make(chan error, 1)
+	go func() {
+		_, _, err := c.Transcribe(make([]float32, audioSampleRate))
+		done <- err
+	}()
+	select {
+	case <-started:
+	case <-time.After(5 * time.Second):
+		t.Fatal("request did not start")
+	}
+	require.NoError(t, c.Destroy())
+	select {
+	case err := <-done:
+		require.ErrorIs(t, err, context.Canceled)
+		require.NotContains(t, err.Error(), "test-api-key")
+		require.NotContains(t, err.Error(), "private-response")
+	case <-time.After(time.Second):
+		t.Fatal("cancellation did not interrupt the response body read")
+	}
+	require.Equal(t, int32(1), requests.Load())
+	_, _, err := c.Transcribe(make([]float32, audioSampleRate))
+	require.ErrorIs(t, err, context.Canceled)
+	require.Equal(t, int32(1), requests.Load(), "a destroyed client must not start another request")
+}
+
+func TestMaintainedMostTranscribeInvalidResponseIsPermanent(t *testing.T) {
+	for name, body := range map[string]string{
+		"syntax":                              `{"text":test-api-key private-response}`,
+		"incomplete JSON, complete HTTP body": `{"text":"test-api-key private-response`,
+		"text type":                           `{"text":["test-api-key private-response"]}`,
+		"segment type":                        `{"segments":[{"start":"test-api-key private-response","end":1,"text":"text"}]}`,
+		"missing timestamp":                   `{"segments":[{"end":1,"text":"test-api-key private-response"}]}`,
+		"missing segment text":                `{"segments":[{"start":0,"end":1}]}`,
+		"backwards timestamps":                `{"segments":[{"start":2,"end":1,"text":"test-api-key private-response"}]}`,
+		"overflowing timestamp":               `{"segments":[{"start":0,"end":1e30,"text":"test-api-key private-response"}]}`,
+		"unsupported object":                  `{"error":"test-api-key private-response"}`,
+		"empty object":                        `{}`,
+		"null":                                `null`,
+		"null text":                           `{"text":null}`,
+		"trailing JSON":                       `{"text":"test-api-key private-response"}{}`,
+		"HTML":                                `<html>test-api-key private-response</html>`,
+		"empty body":                          "",
+	} {
+		t.Run(name, func(t *testing.T) {
+			var requests atomic.Int32
+			srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+				requests.Add(1)
+				fmt.Fprint(w, body)
+			}))
+			defer srv.Close()
+
+			c := newTestClient(t, srv.URL+"/v1")
+			_, _, err := c.Transcribe(make([]float32, audioSampleRate))
+			var permanent permanentError
+			require.ErrorAs(t, err, &permanent)
+			require.NotContains(t, err.Error(), "test-api-key")
+			require.NotContains(t, err.Error(), "private-response")
+			require.Equal(t, int32(1), requests.Load())
+		})
+	}
+}
+
+func TestMaintainedMostTranscribeSilence(t *testing.T) {
+	for _, body := range []string{`{"text":""}`, `{"segments":[]}`} {
+		t.Run(body, func(t *testing.T) {
+			srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+				fmt.Fprint(w, body)
+			}))
+			defer srv.Close()
+			c := newTestClient(t, srv.URL+"/v1")
+			segments, _, err := c.Transcribe(make([]float32, audioSampleRate))
+			require.NoError(t, err)
+			require.Empty(t, segments)
+		})
+	}
+}
+
+func TestMaintainedMostTranscribeUntrustedStatusIsRedacted(t *testing.T) {
+	var requests atomic.Int32
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		requests.Add(1)
+		conn, rw, err := w.(http.Hijacker).Hijack()
+		if err != nil {
+			t.Errorf("hijack: %v", err)
+			return
+		}
+		defer conn.Close()
+		fmt.Fprint(rw, "HTTP/1.1 401 test-api-key private-response\r\nContent-Length: 0\r\n\r\n")
+		if err := rw.Flush(); err != nil {
+			t.Errorf("flush: %v", err)
+		}
+	}))
+	defer srv.Close()
+	c := newTestClient(t, srv.URL+"/v1")
+	_, _, err := c.Transcribe(make([]float32, audioSampleRate))
+	require.EqualError(t, err, "failed to transcribe chunk: request failed with status 401 Unauthorized")
+	require.Equal(t, int32(1), requests.Load())
+}
