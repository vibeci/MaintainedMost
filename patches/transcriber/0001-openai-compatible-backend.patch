index 0000000..d87282d
--- /dev/null
+++ b/cmd/transcriber/apis/openai/client.go
@@ -0,0 +1,404 @@
+// Package openai implements a transcription backend for any service exposing an
+// OpenAI compatible /v1/audio/transcriptions endpoint (e.g. OpenAI, Groq,
+// LocalAI, a self-hosted whisper server).
+//
+// NOTE: using this backend means sending call audio to a third party service.
+package openai
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"log/slog"
+	"math"
+	"mime/multipart"
+	"net/http"
+	"net/url"
+	"strings"
+	"time"
+
+	"github.com/mattermost/calls-transcriber/cmd/transcriber/transcribe"
+)
+
+const (
+	audioSampleRate = 16000
+	audioBitDepth   = 16
+	audioChannels   = 1
+
+	// defaults
+	BaseURLDefault = "https://api.openai.com/v1"
+	ModelDefault   = "whisper-1"
+	TimeoutDefault = 60 * time.Second
+
+	transcriptionsPath = "/audio/transcriptions"
+
+	// OpenAI rejects uploads bigger than 25MB. We keep some margin for the WAV
+	// header and the multipart envelope and split anything longer in chunks.
+	maxUploadBytesDefault = 24 * 1024 * 1024
+
+	// Transient failures (e.g. rate limiting, network errors) are retried.
+	// Authentication and other client errors are not.
+	maxAttempts  = 3
+	retryBackoff = 500 * time.Millisecond
+)
+
+// The local whisper.cpp path returns ISO 639-1 codes while some OpenAI
+// compatible services (OpenAI itself included) return the full English name of
+// the detected language. We map back the most common ones and pass through
+// anything else.
+var langCodes = map[string]string{
+	"arabic": "ar", "bulgarian": "bg", "catalan": "ca", "chinese": "zh", "czech": "cs",
+	"danish": "da", "dutch": "nl", "english": "en", "finnish": "fi", "french": "fr",
+	"german": "de", "greek": "el", "hebrew": "he", "hindi": "hi", "hungarian": "hu",
+	"indonesian": "id", "italian": "it", "japanese": "ja", "korean": "ko", "norwegian": "no",
+	"persian": "fa", "polish": "pl", "portuguese": "pt", "romanian": "ro", "russian": "ru",
+	"slovak": "sk", "spanish": "es", "swedish": "sv", "thai": "th", "turkish": "tr",
+	"ukrainian": "uk", "vietnamese": "vi",
+}
+
+type Config struct {
+	// The base URL of the OpenAI compatible API (e.g. https://api.openai.com/v1).
+	BaseURL string
+	// The API key used to authenticate. Can be empty for self-hosted services
+	// that don't require authentication.
+	APIKey string
+	// The transcription model to use (e.g. whisper-1).
+	Model string
+	// The timeout for a single transcription request.
+	Timeout time.Duration
+}
+
+func (c Config) IsValid() error {
+	if c.BaseURL == "" {
+		return fmt.Errorf("invalid BaseURL: should not be empty")
+	}
+
+	u, err := url.Parse(c.BaseURL)
+	if err != nil {
+		return fmt.Errorf("invalid BaseURL: parsing failed")
+	} else if u.Scheme != "http" && u.Scheme != "https" {
+		return fmt.Errorf("invalid BaseURL: invalid scheme %q", u.Scheme)
+	}
+
+	if c.Model == "" {
+		return fmt.Errorf("invalid Model: should not be empty")
+	}
+
+	if c.Timeout <= 0 {
+		return fmt.Errorf("invalid Timeout: should be a positive duration")
+	}
+
+	return nil
+}
+
+func (c *Config) SetDefaults() {
+	if c.BaseURL == "" {
+		c.BaseURL = BaseURLDefault
+	}
+
+	if c.Model == "" {
+		c.Model = ModelDefault
+	}
+
+	if c.Timeout == 0 {
+		c.Timeout = TimeoutDefault
+	}
+}
+
+// LogValue implements slog.LogValuer so that the API key is never logged.
+func (c Config) LogValue() slog.Value {
+	var apiKey string
+	if c.APIKey != "" {
+		apiKey = "<redacted>"
+	}
+
+	return slog.GroupValue(
+		slog.String("BaseURL", c.BaseURL),
+		slog.String("APIKey", apiKey),
+		slog.String("Model", c.Model),
+		slog.Duration("Timeout", c.Timeout),
+	)
+}
+
+// permanentError marks an error that won't succeed if retried.
+type permanentError struct {
+	err error
+}
+
+func (e permanentError) Error() string { return e.err.Error() }
+func (e permanentError) Unwrap() error { return e.err }
+
+type Client struct {
+	cfg    Config
+	url    string
+	ctx    context.Context
+	cancel context.CancelFunc
+
+	httpClient *http.Client
+
+	// The maximum size of a single upload. Longer audio is split in chunks.
+	maxUploadBytes int
+}
+
+func NewClient(cfg Config) (*Client, error) {
+	cfg.SetDefaults()
+
+	if err := cfg.IsValid(); err != nil {
+		return nil, fmt.Errorf("failed to validate config: %w", err)
+	}
+
+	slog.Debug("creating transcription client", slog.Any("cfg", cfg))
+
+	ctx, cancel := context.WithCancel(context.Background())
+	return &Client{
+		cfg:    cfg,
+		url:    strings.TrimSuffix(cfg.BaseURL, "/") + transcriptionsPath,
+		ctx:    ctx,
+		cancel: cancel,
+		// The timeout is enforced per request through the request's context.
+		httpClient:     &http.Client{},
+		maxUploadBytes: maxUploadBytesDefault,
+	}, nil
+}
+
+func (c *Client) Transcribe(samples []float32) ([]transcribe.Segment, string, error) {
+	if len(samples) == 0 {
+		return nil, "", fmt.Errorf("samples should not be empty")
+	}
+
+	chunkLen := c.maxUploadBytes / (audioBitDepth / 8)
+	if len(samples) > chunkLen {
+		// Splitting is done on a fixed size boundary so it may well cut through
+		// a word. There's not much we can do about it since the API enforces a
+		// maximum upload size.
+		slog.Warn("audio exceeds the maximum upload size, splitting in chunks",
+			slog.Int("samplesLen", len(samples)),
+			slog.Int("chunkLen", chunkLen))
+	}
+
+	var lang string
+	var segments []transcribe.Segment
+	for off := 0; off < len(samples); off += chunkLen {
+		chunk := samples[off:min(off+chunkLen, len(samples))]
+
+		chunkSegments, chunkLang, err := c.transcribeChunk(chunk)
+		if err != nil {
+			return nil, "", fmt.Errorf("failed to transcribe chunk: %w", err)
+		}
+
+		if lang == "" {
+			lang = chunkLang
+		}
+
+		// The returned timestamps are relative to the beginning of the chunk so
+		// we offset them to make them relative to the whole input.
+		offsetMs := int64(off / (audioSampleRate / 1000))
+		for _, s := range chunkSegments {
+			s.StartTS += offsetMs
+			s.EndTS += offsetMs
+			segments = append(segments, s)
+		}
+	}
+
+	return segments, lang, nil
+}
+
+func (c *Client) Destroy() error {
+	c.cancel()
+	c.httpClient.CloseIdleConnections()
+	return nil
+}
+
+type transcriptionResponse struct {
+	Language string  `json:"language"`
+	Text     *string `json:"text"`
+	Segments []struct {
+		Start *float64 `json:"start"`
+		End   *float64 `json:"end"`
+		Text  *string  `json:"text"`
+	} `json:"segments"`
+}
+
+func (c *Client) transcribeChunk(samples []float32) ([]transcribe.Segment, string, error) {
+	body, contentType, err := c.newRequestBody(samples)
+	if err != nil {
+		return nil, "", err
+	}
+
+	durMs := int64(len(samples) / (audioSampleRate / 1000))
+
+	for attempt := 1; ; attempt++ {
+		if err := c.ctx.Err(); err != nil {
+			return nil, "", err
+		}
+		res, err := c.doRequest(body, contentType)
+		if err == nil {
+			return segmentsFromResponse(res, durMs)
+		}
+
+		var permErr permanentError
+		if errors.Is(err, context.Canceled) || errors.As(err, &permErr) || attempt == maxAttempts {
+			return nil, "", err
+		}
+
+		slog.Warn("transcription request failed, retrying",
+			slog.String("err", err.Error()),
+			slog.Int("attempt", attempt))
+
+		timer := time.NewTimer(time.Duration(attempt) * retryBackoff)
+		select {
+		case <-c.ctx.Done():
+			timer.Stop()
+			return nil, "", c.ctx.Err()
+		case <-timer.C:
+		}
+	}
+}
+
+func (c *Client) newRequestBody(samples []float32) ([]byte, string, error) {
+	var buf bytes.Buffer
+	mw := multipart.NewWriter(&buf)
+
+	fw, err := mw.CreateFormFile("file", "audio.wav")
+	if err != nil {
+		return nil, "", fmt.Errorf("failed to create form file: %w", err)
+	}
+
+	if _, err := fw.Write(f32PCMToWAV(samples)); err != nil {
+		return nil, "", fmt.Errorf("failed to write audio data: %w", err)
+	}
+
+	if err := mw.WriteField("model", c.cfg.Model); err != nil {
+		return nil, "", fmt.Errorf("failed to write model field: %w", err)
+	}
+
+	// Needed to get segments, timestamps and the detected language back.
+	if err := mw.WriteField("response_format", "verbose_json"); err != nil {
+		return nil, "", fmt.Errorf("failed to write response_format field: %w", err)
+	}
+
+	if err := mw.Close(); err != nil {
+		return nil, "", fmt.Errorf("failed to close multipart writer: %w", err)
+	}
+
+	return buf.Bytes(), mw.FormDataContentType(), nil
+}
+
+func (c *Client) doRequest(body []byte, contentType string) (*transcriptionResponse, error) {
+	ctx, cancel := context.WithTimeout(c.ctx, c.cfg.Timeout)
+	defer cancel()
+
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, c.url, bytes.NewReader(body))
+	if err != nil {
+		return nil, permanentError{fmt.Errorf("failed to create transcription request")}
+	}
+	req.Header.Set("Content-Type", contentType)
+	if c.cfg.APIKey != "" {
+		req.Header.Set("Authorization", "Bearer "+c.cfg.APIKey)
+	}
+
+	res, err := c.httpClient.Do(req)
+	if err != nil {
+		return nil, transportError("failed to send request", err)
+	}
+	defer res.Body.Close()
+
+	if res.StatusCode != http.StatusOK {
+		// Provider bodies and status text can echo credentials or call audio.
+		err := fmt.Errorf("request failed with status %d %s", res.StatusCode, http.StatusText(res.StatusCode))
+		if !isRetryableStatus(res.StatusCode) {
+			return nil, permanentError{err}
+		}
+		return nil, err
+	}
+
+	// Finish reading before decoding so an interrupted HTTP body is retried,
+	// even if its first bytes happened to contain a complete JSON value.
+	data, err := io.ReadAll(res.Body)
+	if err != nil {
+		return nil, transportError("failed to read response body", err)
+	}
+	var tr transcriptionResponse
+	if err := json.Unmarshal(data, &tr); err != nil {
+		return nil, permanentError{fmt.Errorf("invalid transcription response JSON")}
+	}
+	if tr.Text == nil && tr.Segments == nil {
+		return nil, permanentError{fmt.Errorf("unsupported transcription response")}
+	}
+	for _, s := range tr.Segments {
+		if s.Start == nil || s.End == nil || s.Text == nil ||
+			*s.Start < 0 || *s.End < *s.Start || *s.End >= float64(math.MaxInt64)/1000 {
+			return nil, permanentError{fmt.Errorf("invalid transcription response segment")}
+		}
+	}
+
+	return &tr, nil
+}
+
+// Preserve useful sentinel errors, but never include untrusted transport error
+// strings: they may contain request URLs, headers or response body fragments.
+func transportError(message string, err error) error {
+	for _, cause := range []error{context.Canceled, context.DeadlineExceeded, io.ErrUnexpectedEOF} {
+		if errors.Is(err, cause) {
+			return fmt.Errorf("%s: %w", message, cause)
+		}
+	}
+	return fmt.Errorf("%s: transport error", message)
+}
+
+// isRetryableStatus reports whether a request that failed with the given status
+// code is worth retrying. Authentication, authorization and malformed request
+// failures are permanent.
+func isRetryableStatus(code int) bool {
+	return code == http.StatusRequestTimeout ||
+		code == http.StatusTooManyRequests ||
+		code >= http.StatusInternalServerError
+}
+
+func segmentsFromResponse(res *transcriptionResponse, durMs int64) ([]transcribe.Segment, string, error) {
+	lang := normalizeLanguage(res.Language)
+
+	if len(res.Segments) == 0 {
+		var text string
+		if res.Text != nil {
+			text = strings.TrimSpace(*res.Text)
+		}
+		if text == "" {
+			return nil, lang, nil
+		}
+
+		// Some OpenAI compatible services ignore the verbose_json response
+		// format and only return the full text. The best we can do in that case
+		// is a single segment spanning the whole input.
+		slog.Warn("no segments in response, falling back to a single segment")
+
+		return []transcribe.Segment{{
+			Text:    text,
+			StartTS: 0,
+			EndTS:   durMs,
+		}}, lang, nil
+	}
+
+	segments := make([]transcribe.Segment, 0, len(res.Segments))
+	for _, s := range res.Segments {
+		segments = append(segments, transcribe.Segment{
+			Text: *s.Text,
+			// Timestamps are returned in seconds, ours are in milliseconds.
+			StartTS: int64(*s.Start * 1000),
+			EndTS:   int64(*s.End * 1000),
+		})
+	}
+
+	return segments, lang, nil
+}
+
+func normalizeLanguage(lang string) string {
+	lang = strings.ToLower(strings.TrimSpace(lang))
+	if code, ok := langCodes[lang]; ok {
+		return code
+	}
+	return lang
+}
diff --git a/cmd/transcriber/apis/openai/client_test.go b/cmd/transcriber/apis/openai/client_test.go
new file mode 100644
index 0000000..0d7c1ab
--- /dev/null
+++ b/cmd/transcriber/apis/openai/client_test.go
@@ -0,0 +1,231 @@
+package openai
+
+import (
+	"bytes"
+	"fmt"
+	"io"
+	"log/slog"
+	"net/http"
+	"net/http/httptest"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/mattermost/calls-transcriber/cmd/transcriber/transcribe"
+
+	"github.com/stretchr/testify/require"
+)
+
+func newTestClient(t *testing.T, url string) *Client {
+	t.Helper()
+
+	c, err := NewClient(Config{
+		BaseURL: url,
+		APIKey:  "test-api-key",
+		Model:   "whisper-1",
+		Timeout: time.Second,
+	})
+	require.NoError(t, err)
+	require.NotNil(t, c)
+	t.Cleanup(func() { require.NoError(t, c.Destroy()) })
+
+	return c
+}
+
+func TestConfigIsValid(t *testing.T) {
+	t.Run("empty", func(t *testing.T) {
+		var cfg Config
+		require.Error(t, cfg.IsValid())
+	})
+
+	t.Run("invalid scheme", func(t *testing.T) {
+		cfg := Config{BaseURL: "ftp://example.com", Model: "whisper-1", Timeout: time.Second}
+		require.EqualError(t, cfg.IsValid(), `invalid BaseURL: invalid scheme "ftp"`)
+	})
+
+	t.Run("defaults", func(t *testing.T) {
+		var cfg Config
+		cfg.SetDefaults()
+		require.NoError(t, cfg.IsValid())
+		require.Equal(t, BaseURLDefault, cfg.BaseURL)
+		require.Equal(t, ModelDefault, cfg.Model)
+		require.Equal(t, TimeoutDefault, cfg.Timeout)
+		// An API key is not required as self-hosted services may not need one.
+		require.Empty(t, cfg.APIKey)
+	})
+}
+
+func TestConfigLogValueRedactsAPIKey(t *testing.T) {
+	var buf bytes.Buffer
+	logger := slog.New(slog.NewTextHandler(&buf, nil))
+
+	cfg := Config{BaseURL: BaseURLDefault, APIKey: "super-secret-key", Model: ModelDefault, Timeout: time.Second}
+	logger.Info("cfg", slog.Any("cfg", cfg))
+
+	require.NotContains(t, buf.String(), "super-secret-key")
+	require.Contains(t, buf.String(), "redacted")
+}
+
+func TestTranscribeSuccess(t *testing.T) {
+	var reqs atomic.Int32
+
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		reqs.Add(1)
+
+		require.Equal(t, http.MethodPost, r.Method)
+		require.Equal(t, "/v1/audio/transcriptions", r.URL.Path)
+		require.Equal(t, "Bearer test-api-key", r.Header.Get("Authorization"))
+
+		require.NoError(t, r.ParseMultipartForm(1<<20))
+		require.Equal(t, "whisper-1", r.FormValue("model"))
+		require.Equal(t, "verbose_json", r.FormValue("response_format"))
+
+		file, hdr, err := r.FormFile("file")
+		require.NoError(t, err)
+		defer file.Close()
+		require.Equal(t, "audio.wav", hdr.Filename)
+
+		data, err := io.ReadAll(file)
+		require.NoError(t, err)
+		// 44 bytes of WAV header plus 16-bit samples.
+		require.Equal(t, 44+16000*2, len(data))
+		require.Equal(t, "RIFF", string(data[:4]))
+
+		w.Header().Set("Content-Type", "application/json")
+		fmt.Fprint(w, `{
+			"language": "english",
+			"text": "Hello there. General Kenobi.",
+			"segments": [
+				{"start": 0.0, "end": 1.25, "text": "Hello there."},
+				{"start": 1.25, "end": 2.5, "text": "General Kenobi."}
+			]
+		}`)
+	}))
+	defer srv.Close()
+
+	c := newTestClient(t, srv.URL+"/v1")
+
+	segments, lang, err := c.Transcribe(make([]float32, 16000))
+	require.NoError(t, err)
+	require.Equal(t, int32(1), reqs.Load())
+	// The language is normalized to the ISO 639-1 code the local path returns.
+	require.Equal(t, "en", lang)
+	require.Equal(t, []transcribe.Segment{
+		{Text: "Hello there.", StartTS: 0, EndTS: 1250},
+		{Text: "General Kenobi.", StartTS: 1250, EndTS: 2500},
+	}, segments)
+
+	require.NoError(t, c.Destroy())
+}
+
+func TestTranscribeEmptySamples(t *testing.T) {
+	c := newTestClient(t, "http://localhost:1")
+	_, _, err := c.Transcribe(nil)
+	require.EqualError(t, err, "samples should not be empty")
+}
+
+func TestTranscribeAuthFailure(t *testing.T) {
+	var reqs atomic.Int32
+
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		reqs.Add(1)
+		w.WriteHeader(http.StatusUnauthorized)
+		fmt.Fprint(w, `{"error": {"message": "Incorrect API key provided: test-api-key"}}`)
+	}))
+	defer srv.Close()
+
+	c := newTestClient(t, srv.URL+"/v1")
+
+	_, _, err := c.Transcribe(make([]float32, 16000))
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "401 Unauthorized")
+	require.NotContains(t, err.Error(), "Incorrect API key provided")
+	require.NotContains(t, err.Error(), "test-api-key")
+	// Authentication failures should not be retried.
+	require.Equal(t, int32(1), reqs.Load())
+}
+
+func TestTranscribeRetriesTransientFailure(t *testing.T) {
+	var reqs atomic.Int32
+
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		if reqs.Add(1) == 1 {
+			w.WriteHeader(http.StatusTooManyRequests)
+			return
+		}
+		fmt.Fprint(w, `{"language": "en", "segments": [{"start": 0, "end": 1, "text": "ok"}]}`)
+	}))
+	defer srv.Close()
+
+	c := newTestClient(t, srv.URL+"/v1")
+
+	segments, lang, err := c.Transcribe(make([]float32, 16000))
+	require.NoError(t, err)
+	require.Equal(t, int32(2), reqs.Load())
+	require.Equal(t, "en", lang)
+	require.Equal(t, []transcribe.Segment{{Text: "ok", StartTS: 0, EndTS: 1000}}, segments)
+}
+
+func TestTranscribeTimeout(t *testing.T) {
+	var reqs atomic.Int32
+
+	blockCh := make(chan struct{})
+	srv := httptest.NewServer(http.HandlerFunc(func(_ http.ResponseWriter, r *http.Request) {
+		reqs.Add(1)
+		select {
+		case <-blockCh:
+		case <-r.Context().Done():
+		}
+	}))
+	defer srv.Close()
+	defer close(blockCh)
+
+	c := newTestClient(t, srv.URL+"/v1")
+	c.cfg.Timeout = 100 * time.Millisecond
+
+	_, _, err := c.Transcribe(make([]float32, 16000))
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "context deadline exceeded")
+	// Timeouts are transient so all the attempts should have been made.
+	require.Equal(t, int32(maxAttempts), reqs.Load())
+}
+
+func TestTranscribeChunking(t *testing.T) {
+	var reqs atomic.Int32
+
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		reqs.Add(1)
+		// Each chunk reports a segment covering its first second.
+		fmt.Fprint(w, `{"language": "english", "segments": [{"start": 0, "end": 1, "text": "chunk"}]}`)
+	}))
+	defer srv.Close()
+
+	c := newTestClient(t, srv.URL+"/v1")
+	// Two seconds worth of 16-bit samples per chunk.
+	c.maxUploadBytes = 16000 * 2 * 2
+
+	segments, lang, err := c.Transcribe(make([]float32, 16000*5))
+	require.NoError(t, err)
+	require.Equal(t, int32(3), reqs.Load())
+	require.Equal(t, "en", lang)
+	// Timestamps of the later chunks are offset by the chunk start.
+	require.Equal(t, []transcribe.Segment{
+		{Text: "chunk", StartTS: 0, EndTS: 1000},
+		{Text: "chunk", StartTS: 2000, EndTS: 3000},
+		{Text: "chunk", StartTS: 4000, EndTS: 5000},
+	}, segments)
+}
+
+func TestTranscribeNoSegmentsFallback(t *testing.T) {
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		fmt.Fprint(w, `{"text": " just text "}`)
+	}))
+	defer srv.Close()
+
+	c := newTestClient(t, srv.URL+"/v1")
+
+	segments, lang, err := c.Transcribe(make([]float32, 16000*2))
+	require.NoError(t, err)
+	require.Empty(t, lang)
+	require.Equal(t, []transcribe.Segment{{Text: "just text", StartTS: 0, EndTS: 2000}}, segments)
+}
