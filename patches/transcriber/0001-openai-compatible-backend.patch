+package config
+
+import (
+	"encoding/json"
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestMaintainedMostOpenAIJobConfigRoundTrip(t *testing.T) {
+	oldInTranscriber := inTranscriber
+	inTranscriber = "true"
+	t.Cleanup(func() { inTranscriber = oldInTranscriber })
+	for _, api := range []string{TranscribeAPIWhisperCPP, TranscribeAPIOpenAIAPI} {
+		t.Run(api, func(t *testing.T) {
+			cfg := CallTranscriberConfig{
+				SiteURL:         "https://mattermost.example.com",
+				CallID:          "8w8jorhr7j83uqr6y1st894hqe",
+				PostID:          "udzdsg7dwidbzcidx5khrf8nee",
+				AuthToken:       "qj75unbsef83ik9p7ueypb6iyw",
+				TranscriptionID: "on5yfih5etn5m8rfdidamc1oxa",
+				NumThreads:      1,
+			}
+			cfg.SetDefaults()
+			require.Equal(t, TranscribeAPI(TranscribeAPIWhisperCPP), cfg.TranscribeAPI)
+			input := cfg.ToMap()
+			// Calls applies these job-only overrides after validating its local
+			// config. The offloader serializes the map and uppercases env keys.
+			input["transcribe_api"] = api
+			options := map[string]string{
+				"OPENAI_API_BASE_URL":        "https://speech.example.com/v1",
+				"OPENAI_API_KEY":             "test-key=with-padding",
+				"OPENAI_API_MODEL":           "whisper-large-v3",
+				"OPENAI_API_TIMEOUT_SECONDS": "17",
+			}
+			for key, value := range options {
+				input[strings.ToLower(key)] = value
+			}
+			data, err := json.Marshal(input)
+			require.NoError(t, err)
+			var wireInput map[string]any
+			require.NoError(t, json.Unmarshal(data, &wireInput))
+			var fromMap CallTranscriberConfig
+			require.NoError(t, fromMap.FromMap(wireInput).IsValid())
+			require.Equal(t, TranscribeAPI(api), fromMap.TranscribeAPI)
+			for key, value := range wireInput {
+				t.Setenv(strings.ToUpper(key), fmt.Sprint(value))
+			}
+			fromEnv, err := FromEnv()
+			require.NoError(t, err)
+			fromEnv.SetDefaults()
+			require.NoError(t, fromEnv.IsValid())
+			require.Equal(t, fromMap, fromEnv)
+			for key, value := range options {
+				require.Equal(t, value, fromEnv.APIOption(key))
+			}
+		})
+	}
+}
+
+func TestMaintainedMostOpenAIAPIOptionPrecedence(t *testing.T) {
+	t.Setenv("OPENAI_API_KEY", "environment-key")
+	for _, tc := range []struct {
+		name    string
+		options map[string]any
+		want    string
+	}{
+		{name: "environment fallback", want: "environment-key"},
+		{name: "JSON options win", options: map[string]any{"OPENAI_API_KEY": "job-key"}, want: "job-key"},
+		{name: "empty falls back", options: map[string]any{"OPENAI_API_KEY": ""}, want: "environment-key"},
+		{name: "non-string falls back", options: map[string]any{"OPENAI_API_KEY": 7}, want: "environment-key"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			data, err := json.Marshal(tc.options)
+			require.NoError(t, err)
+			t.Setenv("TRANSCRIBE_API_OPTIONS", string(data))
+			cfg, err := FromEnv()
+			require.NoError(t, err)
+			require.Equal(t, tc.want, cfg.APIOption("OPENAI_API_KEY"))
+			var roundTrip CallTranscriberConfig
+			roundTrip.FromMap(cfg.ToMap())
+			require.Equal(t, tc.want, roundTrip.APIOption("OPENAI_API_KEY"))
+		})
+	}
+}
